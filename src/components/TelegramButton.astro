---
import Icon from './Icon.astro';
---

<a href="https://t.me/+79858258730" target="_blank" rel="noopener" class="tg-btn" id="tg-btn" aria-label="Написать в Telegram">
  <Icon name="svc-telegram" class="tg-icon" />
</a>

<style>
  .tg-btn {
    position: fixed;
    right: 24px;
    bottom: 96px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-moss);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-lift);
    opacity: 0;
    transform: translateY(16px) scale(.9);
    pointer-events: none;
    transition: opacity .3s ease-out, transform .3s ease-out;
    z-index: 90;
  }

  .tg-btn.visible { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }

  .tg-btn :global(.tg-icon) { width: 26px; height: 26px; color: #fff; }

  @media (max-width: 720px) {
    .tg-btn { bottom: 132px; right: 16px; width: 50px; height: 50px; }
  }
</style>

<script>
  const btn = document.getElementById('tg-btn');
  const onScroll = () => btn?.classList.toggle('visible', window.scrollY > 260);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
