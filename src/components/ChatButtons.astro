---
import { maxHref } from '../data/content';
---

<div class="chat-buttons" id="chat-buttons">
  <a href={maxHref} target="_blank" rel="noopener" class="chat-btn max-btn" aria-label="Написать в Max">
    <img src={`${import.meta.env.BASE_URL}icons/brand-max.svg`} alt="" class="chat-icon" width="56" height="56" />
  </a>
  <a href="https://t.me/+79858258730" target="_blank" rel="noopener" class="chat-btn tg-btn" aria-label="Написать в Telegram">
    <img src={`${import.meta.env.BASE_URL}icons/brand-telegram.svg`} alt="" class="chat-icon" width="56" height="56" />
  </a>
</div>

<style>
  .chat-buttons {
    position: fixed;
    right: 24px;
    bottom: 96px;
    z-index: 90;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .chat-btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-lift);
    opacity: 0;
    transform: translateY(16px) scale(.9);
    pointer-events: none;
    transition: opacity .3s ease-out, transform .3s ease-out, box-shadow .2s ease-out, filter .2s ease-out;
  }

  .chat-buttons.visible .chat-btn { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }

  .chat-buttons.visible .chat-btn:hover { filter: brightness(1.08); transform: translateY(0) scale(1.06); }

  /* Официальные иконки мессенджеров (свой фон и фирменный цвет уже внутри
     SVG) — раньше кружок был в цвет var(--color-moss) и сливался с зелёным
     фоном сайта. У MAX сама иконка — скруглённый квадрат чуть крупнее круга
     кнопки, поэтому она немного увеличена и обрезана по кругу через overflow. */
  .chat-icon { width: 100%; height: 100%; display: block; }
  .max-btn .chat-icon { width: 120%; height: 120%; }

  @media (max-width: 720px) {
    .chat-buttons { bottom: 132px; right: 16px; gap: 10px; }
    .chat-btn { width: 50px; height: 50px; }
  }
</style>

<script>
  const wrap = document.getElementById('chat-buttons');
  const onScroll = () => wrap?.classList.toggle('visible', window.scrollY > 260);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
