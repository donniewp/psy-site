---
import { videos, videoFeatures, videoAccentPhoto, videoBadge } from '../data/content';
import Icon from './Icon.astro';

const video = videos[0];
---

<section class="videos section" id="video">
  <div class="container video-feature" data-reveal>
    <div class="video-feature-media">
      <div class="video-collage">
        <div class="video-accent-photo">
          <img
            src={`${import.meta.env.BASE_URL}${videoAccentPhoto.src.replace(/^\//, '')}`}
            alt={videoAccentPhoto.alt}
            loading="lazy"
          />
        </div>

        <div class="video-frame">
          <div class="video-cell">
            <video
              class="video-el"
              poster={`${import.meta.env.BASE_URL}${video.poster.replace(/^\//, '')}`}
              data-src={`${import.meta.env.BASE_URL}${video.src.replace(/^\//, '')}`}
              width="1080"
              height="1920"
              playsinline
              preload="none"
              aria-label={video.alt}
            ></video>
            <button type="button" class="video-play-btn" aria-label={`Смотреть видео: ${video.alt}`}>
              <span class="video-play-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              </span>
            </button>
          </div>
        </div>

        <div class="video-float-badge">
          <Icon name="svc-check" class="badge-icon" />
          <span>{videoBadge}</span>
        </div>
      </div>
    </div>

    <div class="video-feature-copy">
      <span class="eyebrow eyebrow-light">Занятия изнутри</span>
      <h2>Посмотрите, как проходит занятие в мини-группе</h2>
      <p>
        Небольшая группа — это не просто цифра: педагог успевает заметить, кто устал,
        кто отвлёкся, а кто уже готов к более сложному заданию. Занятие держит живой
        темп и при этом остаётся бережным к каждому ребёнку.
      </p>
      <div class="video-tags">
        {videoFeatures.map((f) => <span class="video-tag">{f}</span>)}
      </div>
      <a href="#booking" class="btn video-cta">Записаться на пробное занятие</a>
    </div>
  </div>
</section>

<dialog class="video-dialog" id="video-modal" aria-label={video.alt}>
  <button type="button" class="video-dialog-close" id="video-modal-close" aria-label="Закрыть">
    <Icon name="svc-cross" class="icon" />
  </button>
  <video
    class="video-dialog-el"
    poster={`${import.meta.env.BASE_URL}${video.poster.replace(/^\//, '')}`}
    data-src={`${import.meta.env.BASE_URL}${video.src.replace(/^\//, '')}`}
    width="1080"
    height="1920"
    playsinline
    controls
    preload="none"
    aria-label={video.alt}
  ></video>
</dialog>

<style>
  .videos { background: var(--color-moss-deep); overflow: hidden; }

  .video-feature {
    display: grid;
    grid-template-columns: minmax(0, 460px) 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  .video-feature-media { display: flex; justify-content: center; }

  .video-collage { position: relative; width: 100%; max-width: 400px; padding: 36px 30px 26px 0; }

  .video-accent-photo {
    position: absolute;
    left: -10px;
    bottom: -6px;
    width: 46%;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transform: rotate(-7deg);
    z-index: 1;
  }

  .video-accent-photo img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }

  .video-frame {
    position: relative;
    z-index: 2;
    margin-left: auto;
    width: 84%;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 10px;
    box-shadow: var(--shadow-md);
  }

  .video-cell {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-md);
    overflow: hidden;
    isolation: isolate;
    background: color-mix(in srgb, var(--color-mist) 12%, var(--color-paper));
  }

  .video-el { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; background: var(--color-ink); }

  .video-play-btn {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-play-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, color-mix(in srgb, var(--color-ink) 55%, transparent));
    transition: opacity .2s ease-out;
  }

  .video-play-icon {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    transition: transform .25s cubic-bezier(.34, 1.56, .64, 1);
  }

  .video-play-icon svg { width: 26px; height: 26px; color: var(--color-ink); transform: translateX(1px); }

  .video-play-btn:hover .video-play-icon,
  .video-play-btn:focus-visible .video-play-icon { transform: scale(1.1); }

  .video-play-btn:focus-visible { outline: 2px solid var(--color-lime); outline-offset: -3px; border-radius: var(--radius-md); }

  .video-cell.is-playing .video-play-btn { opacity: 0; pointer-events: none; }

  .video-float-badge {
    position: absolute;
    top: 4px;
    right: -8px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    max-width: 172px;
    font: var(--text-meta);
    font-size: 13px;
    line-height: 1.3;
    color: var(--color-ink);
    animation: floatY 5s ease-in-out infinite;
  }

  .video-float-badge :global(.badge-icon) { width: 18px; height: 18px; color: var(--color-moss); flex-shrink: 0; }

  .video-feature-copy h2 { margin-top: var(--space-3); font: var(--text-h2); font-size: 34px; max-width: 20ch; color: #fff; }
  .video-feature-copy p { margin-top: var(--space-4); font: var(--text-body); color: rgba(255, 255, 255, .75); max-width: 48ch; }

  .video-tags { margin-top: var(--space-5); display: flex; flex-wrap: wrap; gap: var(--space-2); }

  .video-tag {
    font: var(--text-meta);
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    background: rgba(255, 255, 255, .12);
    padding: 5px 12px;
    border-radius: var(--radius-pill);
  }

  .video-cta {
    margin-top: var(--space-6);
    background: var(--color-lime);
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
  }

  .video-cta:hover {
    background: #fff;
    box-shadow: var(--shadow-lift);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .video-feature { grid-template-columns: 1fr; text-align: center; justify-items: center; }
    .video-feature-copy h2,
    .video-feature-copy p { margin-left: auto; margin-right: auto; }
    .video-tags { justify-content: center; }
    .video-collage { margin: 0 auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .video-play-icon, .video-play-btn::before { transition-duration: .01ms; }
    .video-play-btn:hover .video-play-icon, .video-play-btn:focus-visible .video-play-icon { transform: none; }
    .video-float-badge { animation: none; }
  }

  /* Попап видео из ссылки "Смотреть видео с занятий" в Hero — тот же приём,
     что у формы записи: не скроллить вниз, а открыть окно поверх страницы. */
  .video-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    border: none;
    border-radius: var(--radius-lg);
    background: var(--color-ink);
    box-shadow: var(--shadow-lift);
    height: min(85vh, 960px);
    aspect-ratio: 9 / 16;
    max-width: calc(100vw - var(--space-5) * 2);
  }

  .video-dialog[open] { display: block; }

  .video-dialog::backdrop {
    background: color-mix(in srgb, var(--color-ink) 70%, transparent);
    backdrop-filter: blur(2px);
  }

  .video-dialog-el { width: 100%; height: 100%; display: block; object-fit: contain; background: var(--color-ink); }

  .video-dialog-close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 1;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, .16);
    backdrop-filter: blur(4px);
    color: #fff;
    transition: background .2s ease-out, transform .2s ease-out;
  }

  .video-dialog-close:hover { background: rgba(255, 255, 255, .28); transform: scale(1.06); }
  .video-dialog-close :global(.icon) { width: 14px; height: 14px; }

  @media (max-width: 480px) {
    .video-dialog { height: auto; width: calc(100vw - var(--space-5) * 2); }
  }
</style>

<script>
  const cells = Array.from(document.querySelectorAll<HTMLElement>('.video-cell'));

  cells.forEach((cell) => {
    const video = cell.querySelector('video') as HTMLVideoElement | null;
    const playBtn = cell.querySelector('.video-play-btn') as HTMLButtonElement | null;
    if (!video || !playBtn) return;

    const start = () => {
      if (!video.src) {
        const src = video.dataset.src;
        if (src) video.src = src;
      }
      video.controls = true;
      cell.classList.add('is-playing');
      video.play().catch(() => {});
    };

    playBtn.addEventListener('click', start);

    video.addEventListener('ended', () => {
      video.controls = false;
      video.removeAttribute('src');
      video.load();
      cell.classList.remove('is-playing');
    });
  });

  // Ссылка "Смотреть видео с занятий" в Hero раньше просто скроллила к этой
  // секции — теперь открывает видео сразу попапом, без прыжка по странице.
  const videoDialog = document.getElementById('video-modal') as HTMLDialogElement | null;
  const videoDialogEl = videoDialog?.querySelector('video') as HTMLVideoElement | null;
  const videoDialogClose = document.getElementById('video-modal-close');

  const openVideoModal = () => {
    if (!videoDialog || !videoDialogEl) return;
    if (!videoDialogEl.src) {
      const src = videoDialogEl.dataset.src;
      if (src) videoDialogEl.src = src;
    }
    videoDialog.showModal();
    videoDialogEl.currentTime = 0;
    videoDialogEl.play().catch(() => {});
    document.body.style.overflow = 'hidden';
  };

  document.querySelectorAll<HTMLAnchorElement>('a[href="#video"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      openVideoModal();
    });
  });

  videoDialogClose?.addEventListener('click', () => videoDialog?.close());

  videoDialog?.addEventListener('click', (e) => {
    if (e.target === videoDialog) videoDialog.close();
  });

  videoDialog?.addEventListener('close', () => {
    videoDialogEl?.pause();
    if (videoDialogEl) {
      videoDialogEl.currentTime = 0;
      videoDialogEl.removeAttribute('src');
      videoDialogEl.load();
    }
    document.body.style.overflow = '';
  });
</script>
