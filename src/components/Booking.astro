---
import { location, phone, phoneHref, telegramHref, maxHref, bookingEndpoint, yandexMetrikaId } from '../data/content';
import { visits, defaultVisit } from '../data/visits';
---
<dialog class="booking-dialog" id="booking-modal" aria-labelledby="booking-modal-title">
  <button type="button" class="booking-dialog-close" id="booking-modal-close" aria-label="Закрыть">×</button>
  <div class="booking-dialog-scroll">
    <div class="booking-content">
      <h2 id="booking-modal-title">{defaultVisit.title}</h2>
      <p id="booking-price" class="booking-price">{defaultVisit.price}</p>
      <p id="booking-explanation">{defaultVisit.explanation}</p>
      <form id="booking-form" data-endpoint={bookingEndpoint} data-metrika-id={yandexMetrikaId} data-visits={JSON.stringify([defaultVisit, ...visits])}>
        <svg class="booking-blob" viewBox="0 0 300 300" aria-hidden="true" focusable="false"><path d="M245,45 C280,85 285,150 260,205 C235,260 170,290 115,270 C60,250 20,195 30,140 C40,85 95,45 150,35 C190,28 220,15 245,45 Z" /></svg>
        <details class="booking-program" id="booking-program-details">
          <summary><span id="booking-program-summary">Выбрать программу <span class="optional">· необязательно</span></span><span class="change-program">Изменить</span></summary>
          <label><span>Занятие</span><select name="program"><option value="">Помогите выбрать занятие</option>{visits.map(v => <option value={v.value}>{v.label}</option>)}</select></label>
        </details>
        <label><span>Ваше имя</span><input name="name" type="text" required autocomplete="name" maxlength="200" placeholder="Как к вам обращаться" /></label>
        <label><span>Телефон</span><input name="phone" type="tel" required autocomplete="tel" inputmode="tel" maxlength="50" placeholder="+7 (999) 123-45-67" aria-describedby="phone-error" /><span id="phone-error" class="field-error" hidden>Проверьте номер: нужны код страны и от 10 до 15 цифр.</span></label>
        <details class="booking-comment"><summary>Добавить комментарий <span class="optional">· необязательно</span></summary><label><span>Что нам учесть?</span><textarea name="comment" rows="2" maxlength="1000" placeholder="Возраст ребёнка, ваш вопрос или удобное время для звонка"></textarea></label></details>
        <label class="checkbox"><input type="checkbox" name="consent" required /><span>Согласен с <a href="/privacy" target="_blank" rel="noopener">условиями обработки персональных данных</a></span></label>
        <label class="honeypot" aria-hidden="true"><span>Оставьте это поле пустым</span><input name="hp_check" type="text" tabindex="-1" autocomplete="off" /></label>
        {['ym_client_id', 'yclid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'landing_url'].map(name => <input type="hidden" name={name} />)}
        <button class="btn btn-primary form-submit" type="submit">{defaultVisit.action}</button>
        <p class="form-status" id="form-status" role="status" hidden>Отправляем заявку…</p>
        <p class="form-error" id="form-error" role="alert" tabindex="-1" hidden><span id="form-error-text"></span> <a href={phoneHref}>Позвонить: {phone}</a></p>
      </form>
      <div class="booking-alternatives"><span>Удобнее написать?</span><a href={telegramHref} target="_blank" rel="noopener" data-goal="telegram_form">Telegram ↗</a><a href={maxHref} target="_blank" rel="noopener" data-goal="max_form">MAX ↗</a></div>
      <p class="booking-location">{location.metro}<br />{location.hours}</p>
    </div>
    <div class="booking-success" id="booking-success" role="status" tabindex="-1">
      <span class="success-mark" aria-hidden="true">✓</span>
      <h2>{import.meta.env.DEV ? 'Тестовая заявка принята' : 'Заявка отправлена'}</h2>
      <p>{import.meta.env.DEV ? 'Это локальный просмотр. Сообщение в студию не отправлено.' : 'Свяжемся с вами в часы работы студии — с 8:30 до 19:30 — и согласуем время встречи.'}</p>
      <p>Если хотите уточнить что-то сразу: <a href={phoneHref}>{phone}</a>.</p>
      <button class="btn btn-primary" type="button" id="booking-success-close">Хорошо</button>
      <button class="new-request text-link" type="button" id="booking-new-request">Оставить ещё одну заявку</button>
    </div>
  </div>
</dialog>
<style>
  .booking-dialog { position: fixed; inset: 0; margin: auto; padding: 0; width: min(580px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); border: 0; border-radius: var(--radius-lg); background: var(--color-surface); color: var(--color-ink-soft); box-shadow: var(--shadow-md); overflow: hidden; }
  .booking-dialog[open] { display: flex; flex-direction: column; }
  .booking-dialog::backdrop { background: rgb(34 86 77 / .55); backdrop-filter: blur(2px); }
  .booking-dialog-close { position: absolute; right: var(--space-2); top: var(--space-2); width: 44px; height: 44px; font-size: 30px; line-height: 1; border-radius: 50%; color: var(--color-ink); background: var(--color-surface); z-index: 1; }
  .booking-dialog-close:hover { background: var(--color-paper); }
  .booking-dialog-scroll { overflow-y: auto; overscroll-behavior: contain; padding: var(--space-7) var(--space-6) var(--space-5); }
  h2 { font: var(--text-h3); font-size: 29px; padding-right: var(--space-3); }
  .booking-price { color: var(--color-moss); font-size: 15px; font-weight: 600; margin-top: var(--space-3); }
  #booking-explanation { font-size: 14px; line-height: 1.6; margin-top: var(--space-2); }
  form { position: relative; overflow: hidden; background: var(--color-paper); border-radius: var(--radius-lg) var(--radius-lg) var(--radius-lg) var(--radius-xs); padding: var(--space-5); margin-top: var(--space-5); display: grid; gap: var(--space-4); box-shadow: var(--shadow-sm); }
  form > * { position: relative; z-index: 1; }
  form > .booking-blob { position: absolute; bottom: -50px; left: -45px; width: 210px; height: 210px; fill: color-mix(in srgb, var(--color-moss) 6%, transparent); pointer-events: none; z-index: 0; }
  label { display: grid; gap: var(--space-2); color: var(--color-ink); font-size: 14px; }
  label > span { font-weight: 500; }
  input:not([type="checkbox"]), select, textarea { width: 100%; min-width: 0; border: 1px solid var(--color-mist); border-radius: var(--radius-xs); background: var(--color-surface); color: var(--color-ink); font: 400 16px/1.5 var(--font-text); padding: var(--space-3); min-height: 48px; }
  textarea { resize: vertical; }
  input::placeholder, textarea::placeholder { color: var(--color-ink-soft); opacity: 1; }
  input[aria-invalid="true"] { border-color: var(--color-clay); }
  summary { min-height: 44px; cursor: pointer; padding: var(--space-2) 0; font-size: 13px; color: var(--color-moss); }
  .booking-program { border-bottom: 1px solid var(--color-divider); }
  .booking-program summary { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); }
  .booking-program summary::-webkit-details-marker { display: none; }
  .booking-program .change-program { font-size: 12px; text-decoration: underline; text-underline-offset: 3px; flex-shrink: 0; }
  .booking-program label, .booking-comment label { padding: var(--space-2) 0 var(--space-3); }
  .optional { color: var(--color-ink-soft); font-size: 12px; }
  .booking-comment summary { padding-top: 0; min-height: 32px; }
  .checkbox { display: flex; align-items: start; gap: var(--space-3); font-size: 12px; line-height: 1.6; }
  .checkbox input { width: 18px; height: 18px; margin: 1px 0 0; flex-shrink: 0; accent-color: var(--color-moss); }
  .checkbox a { text-decoration: underline; text-underline-offset: 3px; }
  .honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .form-submit { width: 100%; min-height: 48px; padding: var(--space-3); }
  :disabled { cursor: wait; }
  form.is-submitting input, form.is-submitting select, form.is-submitting textarea { opacity: .65; }
  .form-status { font-size: 13px; }
  .form-error { font-size: 13px; line-height: 1.6; color: var(--color-clay); }
  .form-error a { text-decoration: underline; }
  .field-error { font-size: 12px; color: var(--color-clay); }
  .booking-alternatives { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); font-size: 13px; }
  .booking-alternatives a { color: var(--color-moss); text-decoration: underline; text-underline-offset: 3px; display: inline-flex; align-items: center; min-height: 44px; }
  .booking-location { font-size: 12px; text-align: center; margin-top: var(--space-2); }
  .booking-success { display: none; text-align: center; padding: var(--space-5) 0; }
  .booking-dialog.is-sent .booking-content { display: none; }
  .booking-dialog.is-sent .booking-success { display: block; }
  .success-mark { display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 50%; background: var(--color-paper); color: var(--color-moss); font-size: 30px; margin-bottom: var(--space-5); }
  .booking-success p { font-size: 15px; line-height: 1.6; margin-top: var(--space-4); }
  .booking-success p a { text-decoration: underline; }
  .booking-success .btn { margin-top: var(--space-5); width: 100%; }
  .new-request { margin-top: var(--space-3); font-size: 13px; }
  @media (max-width: 600px) { .booking-dialog-scroll { padding: 44px var(--space-5) var(--space-5); } h2 { font-size: 26px; } form { gap: var(--space-3); padding: var(--space-4); } }
</style>
<script>
  import { normalizePhone } from '../lib/phone';
  import type { Visit } from '../data/visits';
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const dialog = document.getElementById('booking-modal') as HTMLDialogElement;
  const scroll = dialog.querySelector<HTMLElement>('.booking-dialog-scroll')!;
  const success = document.getElementById('booking-success')!;
  const error = document.getElementById('form-error')!;
  const errorText = document.getElementById('form-error-text')!;
  const status = document.getElementById('form-status')!;
  const phoneInput = form.elements.namedItem('phone') as HTMLInputElement;
  const phoneError = document.getElementById('phone-error')!;
  const select = form.elements.namedItem('program') as HTMLSelectElement;
  const submit = form.querySelector<HTMLButtonElement>('.form-submit')!;
  const choices = JSON.parse(form.dataset.visits || '[]') as Visit[];
  let currentVisit = choices[0];
  let fillingStarted = false;
  let submitting = false;
  let successSeen = false;
  let returnFocus: HTMLElement | null = null;
  const track = (goal: string, details: Record<string, string> = {}) => {
    try {
      const ym = (window as unknown as { ym?: (...args: unknown[]) => void }).ym;
      if (typeof ym === 'function') ym(Number(form.dataset.metrikaId), 'reachGoal', goal, { page: location.pathname, ...details });
    } catch { /* Analytics never blocks booking. */ }
  };
  const updateCopy = () => {
    currentVisit = choices.find(v => v.value === select.value) || choices[0];
    document.getElementById('booking-modal-title')!.textContent = currentVisit.title;
    document.getElementById('booking-price')!.textContent = currentVisit.price;
    document.getElementById('booking-explanation')!.textContent = currentVisit.explanation;
    document.getElementById('booking-program-summary')!.textContent = select.value ? currentVisit.label : 'Выбрать программу · необязательно';
    submit.textContent = submitting ? 'Отправляем…' : currentVisit.action;
  };
  select.addEventListener('change', () => { updateCopy(); (document.getElementById('booking-program-details') as HTMLDetailsElement).open = false; });
  form.addEventListener('input', e => {
    const field = e.target as HTMLInputElement;
    if (!fillingStarted && ['name', 'phone', 'program', 'comment'].includes(field.name) && field.value) { fillingStarted = true; track('booking_start'); }
  });

  // Keep attribution across the homepage → program → booking path.
  const params = new URLSearchParams(location.search);
  const keys = ['yclid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
  let saved: Record<string, string> = {};
  try { saved = JSON.parse(sessionStorage.getItem('attribution_params') || '{}') || {}; } catch { /* Storage can be disabled. */ }
  const attribution = { ...saved };
  for (const key of keys) {
    if (params.get(key)) attribution[key] = params.get(key)!;
    (form.elements.namedItem(key) as HTMLInputElement).value = typeof attribution[key] === 'string' ? attribution[key] : '';
  }
  try { sessionStorage.setItem('attribution_params', JSON.stringify(attribution)); } catch { /* Optional. */ }
  let landingUrl = location.href;
  try { landingUrl = sessionStorage.getItem('landing_url') || location.href; sessionStorage.setItem('landing_url', landingUrl); } catch { /* Optional. */ }
  (form.elements.namedItem('landing_url') as HTMLInputElement).value = landingUrl;
  try {
    const ym = (window as unknown as { ym?: (...args: unknown[]) => void }).ym;
    ym?.(Number(form.dataset.metrikaId), 'getClientID', (id: string) => { (form.elements.namedItem('ym_client_id') as HTMLInputElement).value = id; });
  } catch { /* Optional. */ }

  const validatePhone = () => {
    const invalid = !!phoneInput.value && !normalizePhone(phoneInput.value);
    phoneInput.setCustomValidity(invalid ? 'Введите номер телефона: от 10 до 15 цифр с кодом страны.' : '');
    phoneInput.setAttribute('aria-invalid', String(invalid));
    phoneError.hidden = !invalid;
    return !invalid;
  };
  phoneInput.addEventListener('input', () => { phoneInput.setCustomValidity(''); phoneInput.removeAttribute('aria-invalid'); phoneError.hidden = true; });
  form.addEventListener('invalid', () => track('booking_validation'), true);
  const setSubmitting = (value: boolean) => {
    submitting = value;
    form.classList.toggle('is-submitting', value);
    form.setAttribute('aria-busy', String(value));
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | HTMLButtonElement>('input, select, textarea, button').forEach(el => { el.disabled = value; });
    submit.textContent = value ? 'Отправляем…' : currentVisit.action;
    status.hidden = !value;
  };
  const showError = (message: string) => { errorText.textContent = message; error.hidden = false; if (dialog.open) { error.focus(); error.scrollIntoView({ block: 'nearest' }); } };
  form.addEventListener('submit', async e => {
    e.preventDefault();
    if (submitting) return;
    if (!validatePhone() || !form.checkValidity()) { track('booking_validation'); form.reportValidity(); return; }
    const data = Object.fromEntries(new FormData(form).entries());
    data.name = String(data.name || '').trim();
    if (!data.name) { (form.elements.namedItem('name') as HTMLInputElement).focus(); showError('Укажите, как к вам обращаться.'); return; }
    data.phone = normalizePhone(phoneInput.value)!;
    error.hidden = true;
    track('booking_attempt');
    setSubmitting(true);
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 15000);
    let kind = 'network';
    try {
      const endpoint = form.dataset.endpoint;
      if (!endpoint) { kind = 'configuration'; throw new Error('Missing endpoint'); }
      const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data), signal: controller.signal });
      if (!res.ok) { kind = `http_${res.status}`; throw new Error('Request rejected'); }
      // Accept the existing Worker's explicit OK response as well as its new JSON contract.
      const body = await res.text();
      let confirmed = body.trim() === 'OK';
      if (!confirmed) { try { confirmed = JSON.parse(body)?.ok === true; } catch { /* Not a confirmation. */ } }
      if (!confirmed) { kind = 'invalid_response'; throw new Error('Missing confirmation'); }
      dialog.classList.add('is-sent');
      successSeen = false;
      if (dialog.open) { successSeen = true; scroll.scrollTo({ top: 0 }); success.focus(); }
      track('form_submit');
    } catch {
      const timedOut = controller.signal.aborted;
      track('booking_error', { kind: timedOut ? 'timeout' : kind });
      showError(timedOut
        ? 'Не получили подтверждение отправки. Заявка могла дойти — уточните у нас перед повторной отправкой.'
        : kind === 'http_400' ? 'Проверьте имя и номер телефона и отправьте заявку ещё раз. Введённые данные сохранены.'
        : 'Не удалось отправить заявку. Данные сохранены: попробуйте ещё раз или свяжитесь с нами напрямую.');
    } finally { window.clearTimeout(timeout); setSubmitting(false); }
  });
  const resetAfterSend = () => {
    if (!dialog.classList.contains('is-sent')) return;
    dialog.classList.remove('is-sent'); successSeen = false; fillingStarted = false;
    ['name', 'phone', 'comment', 'hp_check'].forEach(name => { (form.elements.namedItem(name) as HTMLInputElement).value = ''; });
    (form.elements.namedItem('consent') as HTMLInputElement).checked = false;
    select.value = ''; error.hidden = true; validatePhone(); updateCopy();
  };
  const openBooking = (value: string | null = null) => {
    // A completed background request must remain visible until acknowledged.
    if (dialog.classList.contains('is-sent') && successSeen) resetAfterSend();
    if (!submitting && !dialog.classList.contains('is-sent')) {
      const desired = value || document.querySelector<HTMLElement>('[data-booking-program]')?.dataset.bookingProgram;
      if (desired && choices.some(v => v.value === desired)) select.value = desired;
      updateCopy();
    }
    if (!dialog.open) {
      returnFocus = document.activeElement as HTMLElement;
      dialog.showModal(); document.body.style.overflow = 'hidden'; track('booking_open');
      scroll.scrollTo({ top: 0 });
      if (dialog.classList.contains('is-sent')) { successSeen = true; success.focus(); }
      else (form.elements.namedItem('name') as HTMLInputElement).focus({ preventScroll: true });
    }
  };
  document.addEventListener('click', e => {
    const trigger = (e.target as Element)?.closest<HTMLAnchorElement>('a[href*="#booking"]');
    if (!trigger) return;
    e.preventDefault();
    openBooking(new URL(trigger.href, location.href).searchParams.get('program'));
  });
  document.getElementById('booking-modal-close')?.addEventListener('click', () => dialog.close());
  document.getElementById('booking-success-close')?.addEventListener('click', () => dialog.close());
  document.getElementById('booking-new-request')?.addEventListener('click', () => { resetAfterSend(); (form.elements.namedItem('name') as HTMLInputElement).focus(); });
  dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => {
    if (!document.querySelector('dialog[open]')) document.body.style.overflow = '';
    returnFocus?.focus({ preventScroll: true });
  });
  if (location.hash === '#booking') openBooking(params.get('program'));
</script>
