---
import { razvivaykaBlocks, razvivaykaBenefits } from '../data/content';
import Icon from './Icon.astro';
import FigmaAsset from './FigmaAsset.astro';

// Хью — только микро-акценты (точка станции, кольцо, подпись), не заливка крупных
// поверхностей. Контраст accentDark на --color-surface/--color-paper проверен на AA.
const blocks = razvivaykaBlocks.map((b, i) => ({
  ...b,
  slug: ['read', 'neuro', 'sand', 'draw', 'logic'][i],
  accent: ['#1F7A34', '#6B3FB8', '#9C4F0E', '#1868A8', '#0B6C5D'][i],
  accentDark: ['#155C27', '#4E2C8C', '#7A3D0A', '#124E80', '#08544A'][i],
  hue: [108, 265, 30, 205, 168][i],
  from: i * 30,
  to: i * 30 + 30,
}));
---

<section class="razvivayka section" id="razvivayka" style={`--active-hue: ${blocks[0].hue};`}>
  <div class="razvivayka-bg" aria-hidden="true" id="raz-bg">
    <div class="raz-blob raz-blob-1"></div>
    <div class="raz-blob raz-blob-2"></div>
    <span class="raz-doodle raz-doodle-cloud"><FigmaAsset src="illustrations/doodles/cloud.svg" alt="" /></span>
    <span class="raz-doodle raz-doodle-arrow"><FigmaAsset src="illustrations/doodles/arrow.svg" alt="" /></span>
    <span class="raz-doodle raz-doodle-clip"><FigmaAsset src="illustrations/doodles/paper-clip.svg" alt="" /></span>
    <span class="raz-doodle raz-doodle-q"><FigmaAsset src="illustrations/doodles/question-mark.svg" alt="" /></span>
  </div>

  <div class="razvivayka-sticker razvivayka-star" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0l2.7 8.3H24l-7 5.1 2.7 8.3L12 16.6 4.3 21.7 7 13.4 0 8.3h9.3z"/></svg>
  </div>
  <div class="razvivayka-sticker razvivayka-heart" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7.5-4.6-10.2-9.1C.1 9 1 5.4 4.2 4.1 6.6 3.1 9.2 4 12 7c2.8-3 5.4-3.9 7.8-2.9 3.2 1.3 4.1 4.9 2.4 7.8C19.5 16.4 12 21 12 21z"/></svg>
  </div>

  <div class="container">
    <div class="section-head" data-raz-reveal="0">
      <div class="section-head-text">
        <div class="razvivayka-eyebrow-row">
          <span class="eyebrow">Флагманская программа · 4–6 лет</span>
          <span class="morning-badge"><Icon name="svc-clock" class="morning-icon" />Утренние занятия</span>
        </div>
        <h2 class="razvivayka-h2">«Развивай-ка» — одно утро, 5 станций развития</h2>
        <p>
          Для ребят, чей маршрут — от дома к школе, но которым важно развиваться,
          получать знания, общаться со сверстниками и формировать важные умения
          в соответствии с сензитивными периодами.
        </p>
      </div>
      <img
        class="section-head-illustration"
        src={`${import.meta.env.BASE_URL}img/razvivayka-pathway.png`}
        alt=""
        aria-hidden="true"
        width="647"
        height="633"
        loading="lazy"
      />
    </div>

    <div class="raz-route" data-raz-reveal="1" id="raz-route">
     <div class="raz-route-pin" id="raz-route-pin">
      <div class="raz-route-stops" role="tablist" aria-label={`Маршрут занятия «Развивай-ка»: 5 станций, 150 минут`}>
        <span class="raz-route-line" aria-hidden="true"><span class="raz-route-line-fill" id="raz-route-line-fill"></span></span>

        {blocks.map((b, i) => (
          <div class="raz-stop-wrap">
            <button
              type="button"
              class="raz-stop"
              role="tab"
              id={`raz-tab-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`raz-panel-${i} raz-panel-m-${i}`}
              tabindex={i === 0 ? '0' : '-1'}
              data-index={i}
              style={`--stop-accent: ${b.accent}; --stop-accent-dark: ${b.accentDark};`}
            >
              <span class="raz-stop-dot" aria-hidden="true">
                <span class="raz-stop-dot-icon">
                {b.slug === 'read' && (
                  <svg viewBox="0 0 200 200" class="raz-svg"><g><path d="M100 60 C70 50 45 55 30 65 L30 150 C45 140 70 138 100 148 Z" /><path d="M100 60 C130 50 155 55 170 65 L170 150 C155 140 130 138 100 148 Z" /><line x1="100" y1="60" x2="100" y2="148" /></g></svg>
                )}
                {b.slug === 'neuro' && (
                  <svg viewBox="0 0 200 200" class="raz-svg"><path d="M100 100 L45 55" /><path d="M100 100 L155 50" /><path d="M100 100 L40 130" /><path d="M100 100 L160 135" /><path d="M100 100 L100 165" /><circle cx="100" cy="100" r="18" /></svg>
                )}
                {b.slug === 'sand' && (
                  <svg viewBox="0 0 200 200" class="raz-svg"><circle cx="150" cy="55" r="30" /><path d="M0 140 Q50 110 100 135 T200 130 V200 H0 Z" /><path d="M0 165 Q60 140 110 160 T200 155 V200 H0 Z" /></svg>
                )}
                {b.slug === 'draw' && (
                  <svg viewBox="0 0 200 200" class="raz-svg"><path fill="none" d="M40 150 C40 100 60 60 100 60 C140 60 140 100 100 100 C75 100 75 130 100 130 C125 130 130 90 160 80 C175 75 185 85 180 100" /><circle cx="180" cy="100" r="5" /></svg>
                )}
                {b.slug === 'logic' && (
                  <svg viewBox="0 0 200 200" class="raz-svg"><path d="M40 60 H95 V80 A12 12 0 0 1 95 104 V120 H40 V104 A12 12 0 0 0 40 80 Z" /><path d="M105 60 H160 V120 H105 V104 A12 12 0 0 0 105 80 Z" /></svg>
                )}
                </span>
              </span>
              <span class="raz-stop-meta">
                <span class="raz-stop-title">{b.title}</span>
                <span class="raz-stop-range">{b.from}–{b.to} мин</span>
              </span>
            </button>

            <div class="raz-panel-mobile" id={`raz-panel-m-${i}`} role="tabpanel" aria-labelledby={`raz-tab-${i}`} data-active={i === 0 ? 'true' : 'false'} aria-hidden={i === 0 ? 'false' : 'true'} data-slug={b.slug} style={`--stop-accent: ${b.accent}; --stop-accent-dark: ${b.accentDark};`}>
              <div class="raz-panel-inner">
                <span class="raz-panel-visual" aria-hidden="true">
                  <span class="raz-panel-visual-scale">
                  {b.slug === 'read' && (
                    <svg viewBox="0 0 200 200" class="raz-svg raz-svg-read"><g class="read-book"><path class="read-page read-page-l" d="M100 60 C70 50 45 55 30 65 L30 150 C45 140 70 138 100 148 Z" /><path class="read-page read-page-r" d="M100 60 C130 50 155 55 170 65 L170 150 C155 140 130 138 100 148 Z" /><line class="read-spine" x1="100" y1="60" x2="100" y2="148" /></g><text class="read-letter read-letter-1" x="60" y="57">А</text><text class="read-letter read-letter-2" x="95" y="42">Б</text><text class="read-letter read-letter-3" x="130" y="54">В</text></svg>
                  )}
                  {b.slug === 'neuro' && (
                    <svg viewBox="0 0 200 200" class="raz-svg raz-svg-neuro"><g class="neuro-dendrites"><path class="neuro-line" d="M100 100 L45 55" /><path class="neuro-line" d="M100 100 L155 50" /><path class="neuro-line" d="M100 100 L40 130" /><path class="neuro-line" d="M100 100 L160 135" /><path class="neuro-line" d="M100 100 L100 165" /></g><circle class="neuro-node" cx="45" cy="55" r="6" /><circle class="neuro-node" cx="155" cy="50" r="6" /><circle class="neuro-node" cx="40" cy="130" r="6" /><circle class="neuro-node" cx="160" cy="135" r="6" /><circle class="neuro-node" cx="100" cy="165" r="6" /><circle class="neuro-soma" cx="100" cy="100" r="18" /></svg>
                  )}
                  {b.slug === 'sand' && (
                    <svg viewBox="0 0 200 200" class="raz-svg raz-svg-sand"><circle class="sand-sun" cx="150" cy="55" r="30" /><path class="sand-dune sand-dune-back" d="M0 140 Q50 110 100 135 T200 130 V200 H0 Z" /><path class="sand-dune sand-dune-front" d="M0 165 Q60 140 110 160 T200 155 V200 H0 Z" /><circle class="sand-grain" cx="55" cy="175" r="3" /><circle class="sand-grain" cx="80" cy="182" r="2.4" /><circle class="sand-grain" cx="120" cy="178" r="3.2" /><circle class="sand-grain" cx="145" cy="185" r="2.2" /></svg>
                  )}
                  {b.slug === 'draw' && (
                    <svg viewBox="0 0 200 200" class="raz-svg raz-svg-draw"><path class="draw-line" pathLength="100" d="M40 150 C40 100 60 60 100 60 C140 60 140 100 100 100 C75 100 75 130 100 130 C125 130 130 90 160 80 C175 75 185 85 180 100" /><circle class="draw-tip" cx="180" cy="100" r="5" /></svg>
                  )}
                  {b.slug === 'logic' && (
                    <svg viewBox="0 0 200 200" class="raz-svg raz-svg-logic"><path class="logic-piece logic-piece-a" d="M40 60 H95 V80 A12 12 0 0 1 95 104 V120 H40 V104 A12 12 0 0 0 40 80 Z" /><path class="logic-piece logic-piece-b" d="M105 60 H160 V120 H105 V104 A12 12 0 0 0 105 80 Z" /><g class="logic-rays"><line x1="100" y1="30" x2="100" y2="42" /><line x1="70" y1="40" x2="78" y2="48" /><line x1="130" y1="40" x2="122" y2="48" /></g></svg>
                  )}
                  </span>
                </span>
                <div class="raz-panel-text">
                  <span class="raz-panel-badge">{b.title}</span>
                  <p>{b.text}</p>
                  <span class="raz-panel-duration"><Icon name="svc-clock" class="duration-icon" />{b.from}–{b.to} мин</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="raz-stage" id="raz-stage">
        {blocks.map((b, i) => (
          <div class="raz-panel" id={`raz-panel-${i}`} role="tabpanel" aria-labelledby={`raz-tab-${i}`} data-active={i === 0 ? 'true' : 'false'} aria-hidden={i === 0 ? 'false' : 'true'} data-slug={b.slug} style={`--stop-accent: ${b.accent}; --stop-accent-dark: ${b.accentDark};`}>
            <span class="raz-panel-visual" aria-hidden="true">
              <span class="raz-panel-visual-scale">
              {b.slug === 'read' && (
                <svg viewBox="0 0 200 200" class="raz-svg raz-svg-read"><g class="read-book"><path class="read-page read-page-l" d="M100 60 C70 50 45 55 30 65 L30 150 C45 140 70 138 100 148 Z" /><path class="read-page read-page-r" d="M100 60 C130 50 155 55 170 65 L170 150 C155 140 130 138 100 148 Z" /><line class="read-spine" x1="100" y1="60" x2="100" y2="148" /></g><text class="read-letter read-letter-1" x="60" y="57">А</text><text class="read-letter read-letter-2" x="95" y="42">Б</text><text class="read-letter read-letter-3" x="130" y="54">В</text></svg>
              )}
              {b.slug === 'neuro' && (
                <svg viewBox="0 0 200 200" class="raz-svg raz-svg-neuro"><g class="neuro-dendrites"><path class="neuro-line" d="M100 100 L45 55" /><path class="neuro-line" d="M100 100 L155 50" /><path class="neuro-line" d="M100 100 L40 130" /><path class="neuro-line" d="M100 100 L160 135" /><path class="neuro-line" d="M100 100 L100 165" /></g><circle class="neuro-node" cx="45" cy="55" r="6" /><circle class="neuro-node" cx="155" cy="50" r="6" /><circle class="neuro-node" cx="40" cy="130" r="6" /><circle class="neuro-node" cx="160" cy="135" r="6" /><circle class="neuro-node" cx="100" cy="165" r="6" /><circle class="neuro-soma" cx="100" cy="100" r="18" /></svg>
              )}
              {b.slug === 'sand' && (
                <svg viewBox="0 0 200 200" class="raz-svg raz-svg-sand"><circle class="sand-sun" cx="150" cy="55" r="30" /><path class="sand-dune sand-dune-back" d="M0 140 Q50 110 100 135 T200 130 V200 H0 Z" /><path class="sand-dune sand-dune-front" d="M0 165 Q60 140 110 160 T200 155 V200 H0 Z" /><circle class="sand-grain" cx="55" cy="175" r="3" /><circle class="sand-grain" cx="80" cy="182" r="2.4" /><circle class="sand-grain" cx="120" cy="178" r="3.2" /><circle class="sand-grain" cx="145" cy="185" r="2.2" /></svg>
              )}
              {b.slug === 'draw' && (
                <svg viewBox="0 0 200 200" class="raz-svg raz-svg-draw"><path class="draw-line" pathLength="100" d="M40 150 C40 100 60 60 100 60 C140 60 140 100 100 100 C75 100 75 130 100 130 C125 130 130 90 160 80 C175 75 185 85 180 100" /><circle class="draw-tip" cx="180" cy="100" r="5" /></svg>
              )}
              {b.slug === 'logic' && (
                <svg viewBox="0 0 200 200" class="raz-svg raz-svg-logic"><path class="logic-piece logic-piece-a" d="M40 60 H95 V80 A12 12 0 0 1 95 104 V120 H40 V104 A12 12 0 0 0 40 80 Z" /><path class="logic-piece logic-piece-b" d="M105 60 H160 V120 H105 V104 A12 12 0 0 0 105 80 Z" /><g class="logic-rays"><line x1="100" y1="30" x2="100" y2="42" /><line x1="70" y1="40" x2="78" y2="48" /><line x1="130" y1="40" x2="122" y2="48" /></g></svg>
              )}
              </span>
            </span>
            <div class="raz-panel-text">
              <span class="raz-panel-badge">{b.title}</span>
              <p>{b.text}</p>
              <span class="raz-panel-duration"><Icon name="svc-clock" class="duration-icon" />{b.from}–{b.to} мин</span>
            </div>
          </div>
        ))}
      </div>
     </div>
    </div>

    <div class="razvivayka-footer" data-raz-reveal="2">
      <div class="benefits">
        <h3>Программа помогает ребёнку</h3>
        <ul class="tick-list">
          {razvivaykaBenefits.map((b) => <li>{b}</li>)}
        </ul>
      </div>

      <div class="duration-card">
        <span class="eyebrow">Стоимость</span>
        <div class="duration-value">1 900 ₽</div>
        <p>За одно занятие · мини-группа до 8–10 детей · утром</p>
        <a href="#booking" class="btn btn-primary">Узнать расписание и стоимость</a>
      </div>
    </div>
  </div>
</section>

<style>
  .razvivayka {
    position: relative;
    /* Никакого overflow здесь: даже overflow-x:hidden заставляет браузер
       выставить overflow-y:auto (так работает CSS для смешанных значений),
       а auto ломает position:sticky у пина станций ниже точно так же, как
       hidden. Обрезку от вылезающих блобов/доодлов даёт .razvivayka-bg сама. */
    --active-hue: 108;
    transition: background-color .4s ease-out;
  }

  /* ===== Фон: доодлы, пятна, зерно ===== */
  .razvivayka-bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 0; }

  .raz-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: .3;
    background: hsl(var(--active-hue) 60% 78%);
    transition: background .4s ease-out;
    will-change: transform;
  }

  .raz-blob-1 { width: 420px; height: 420px; top: -140px; right: -120px; }
  .raz-blob-2 { width: 320px; height: 320px; bottom: -100px; left: -80px; }

  .raz-doodle { position: absolute; opacity: .4; width: 46px; height: 46px; color: var(--color-mist); will-change: transform; }
  .raz-doodle :global(svg) { width: 100%; height: 100%; }
  .raz-doodle-cloud { top: 8px; left: 6%; width: 64px; height: 64px; }
  .raz-doodle-arrow { top: 22%; right: 14%; }
  .raz-doodle-clip { bottom: 8px; left: 16%; }
  .raz-doodle-q { bottom: 16%; right: 10%; }

  .razvivayka-sticker { position: absolute; pointer-events: none; opacity: .5; z-index: 1; }
  .razvivayka-sticker svg { width: 100%; height: 100%; }
  .razvivayka-star { top: 8%; right: 6%; width: 34px; height: 34px; color: #F4C542; animation: razSpin 9s linear infinite; }
  .razvivayka-heart { bottom: 24px; left: 4%; width: 28px; height: 28px; color: #F0819A; animation: razFloat 5s ease-in-out infinite; }

  @keyframes razSpin { to { transform: rotate(360deg); } }
  @keyframes razFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

  .container { position: relative; z-index: 2; }

  /* ===== Reveal со стаггером ===== */
  [data-raz-reveal] {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity .55s cubic-bezier(.22, 1, .36, 1), transform .55s cubic-bezier(.22, 1, .36, 1);
  }

  [data-raz-reveal].is-shown { opacity: 1; transform: translateY(0); }

  .razvivayka-eyebrow-row { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }

  .morning-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: var(--text-label);
    letter-spacing: var(--tracking-label);
    color: #9C5B0E;
    background: #FBE4CC;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-3);
  }

  .morning-badge :global(.morning-icon) { width: 12px; height: 12px; }

  .razvivayka-h2 { color: var(--color-ink); }

  .section-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); max-width: none; }
  .section-head-text { flex: 1; min-width: 0; }

  .section-head-illustration {
    flex-shrink: 0;
    width: clamp(180px, 18vw, 260px);
    height: auto;
    display: block;
  }

  /* ===== Маршрут: линия + станции + сцена — один объект ===== */
  .raz-route { position: relative; margin-top: var(--space-6); }

  /* На десктопе .raz-route растягивается JS-ом на несколько экранов, а этот
     блок «прилипает» под хедером — станции листаются самим скроллом, без
     таймера и без лишних кликов. */
  @media (min-width: 901px) {
    .raz-route-pin { position: sticky; top: 100px; }
  }

  .raz-route-stops {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .raz-route-line {
    position: absolute;
    left: 22px;
    right: 22px;
    top: 22px;
    height: var(--stroke-bold);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-mist) 30%, var(--color-paper));
    overflow: hidden;
    z-index: 0;
  }

  .raz-route-line-fill {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--color-moss);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .8s cubic-bezier(.22, 1, .36, 1);
  }

  .raz-route.is-filled .raz-route-line-fill { transform: scaleX(1); }

  .raz-stop-wrap { position: relative; z-index: 1; display: flex; flex-direction: column; flex: 1; min-width: 0; }

  .raz-stop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
    font-family: inherit;
    padding: 0;
  }

  .raz-stop-dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--stop-accent) 14%, var(--color-surface));
    box-shadow: inset 0 0 0 var(--stroke-thin) color-mix(in srgb, var(--stop-accent) 40%, transparent);
    transition: background-color .25s ease-out, box-shadow .25s ease-out, transform .3s cubic-bezier(.34, 1.56, .64, 1);
  }

  .raz-stop-dot-icon { width: 22px; height: 22px; color: var(--stop-accent-dark); }
  .raz-stop-dot-icon :global(svg) { width: 100%; height: 100%; overflow: visible; fill: none; stroke: currentColor; stroke-width: 8; stroke-linecap: round; }
  .raz-stop-dot-icon :global(svg circle:not([r="18"])) { fill: currentColor; stroke: none; }
  .raz-stop-dot-icon :global(svg circle[r="18"]) { fill: color-mix(in srgb, currentColor 25%, transparent); }

  .raz-stop[aria-selected="true"] .raz-stop-dot {
    background: var(--stop-accent);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--stop-accent) 45%, transparent);
    transform: scale(1.08);
  }

  .raz-stop[aria-selected="true"] .raz-stop-dot-icon { color: #fff; }

  .raz-stop:hover .raz-stop-dot,
  .raz-stop:focus-visible .raz-stop-dot { transform: scale(1.08); }

  .raz-stop:focus-visible { outline: 2px solid var(--stop-accent-dark); outline-offset: 4px; border-radius: var(--radius-xs); }

  .raz-stop-meta { display: flex; flex-direction: column; gap: 2px; }
  .raz-stop-title { font: var(--text-meta); font-weight: 700; color: var(--color-ink); }
  .raz-stop-range { font: var(--text-label); font-size: 11.5px; letter-spacing: var(--tracking-label); color: var(--color-ink-soft); }

  /* ===== Мобильная inline-панель (по умолчанию видна, скрыта на десктопе) ===== */
  .raz-panel-mobile {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows .4s cubic-bezier(.22, 1, .36, 1), opacity .3s ease-out;
  }

  .raz-panel-mobile[data-active="true"] { grid-template-rows: 1fr; opacity: 1; }

  .raz-panel-inner { overflow: hidden; min-height: 0; }

  .raz-panel-mobile .raz-panel-inner {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) 0 var(--space-2);
  }

  .raz-panel-mobile .raz-panel-visual { width: 88px; height: 88px; flex-shrink: 0; }

  /* ===== Сцена: десктопная единая "стадия", все панели наложены друг на друга ===== */
  .raz-stage {
    display: none;
    position: relative;
    margin-top: var(--space-6);
    min-height: clamp(260px, 26vw, 320px);
  }

  .raz-panel {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: var(--space-7);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--space-7);
    opacity: 0;
    transform: scale(.97);
    filter: blur(4px);
    pointer-events: none;
    transition: opacity .4s cubic-bezier(.22, 1, .36, 1), transform .4s cubic-bezier(.22, 1, .36, 1), filter .3s ease-out;
  }

  .raz-panel[data-active="true"] {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
    pointer-events: auto;
    box-shadow: var(--shadow-md);
  }

  .raz-panel-visual {
    position: relative;
    flex-shrink: 0;
    width: clamp(160px, 16vw, 200px);
    height: clamp(160px, 16vw, 200px);
    overflow: hidden;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--stop-accent) 8%, var(--color-paper));
  }

  .raz-panel-visual-scale { position: absolute; inset: 0; display: block; padding: 14%; }

  .raz-svg { width: 100%; height: 100%; overflow: visible; }

  .raz-panel-text { flex: 1; min-width: 0; }

  .raz-panel-badge {
    display: inline-flex;
    font: var(--text-lead);
    font-size: 17px;
    font-weight: 700;
    color: var(--stop-accent-dark);
  }

  .raz-panel-text p { margin-top: var(--space-2); font: var(--text-body); color: var(--color-ink-soft); max-width: 46ch; }

  .raz-panel-duration {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-4);
    font: var(--text-label);
    color: var(--stop-accent-dark);
    background: color-mix(in srgb, var(--stop-accent) 12%, var(--color-surface));
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .raz-panel-duration :global(.duration-icon) { width: 13px; height: 13px; }

  /* Читай-ка */
  .read-page { fill: color-mix(in srgb, var(--stop-accent) 22%, white); stroke: var(--stop-accent-dark); stroke-width: 3; }
  .read-spine { stroke: var(--stop-accent-dark); stroke-width: 3; }
  .read-letter { font: 600 22px var(--font-display); fill: var(--stop-accent-dark); opacity: 0; transform: translateY(6px); transition: opacity .3s ease-out, transform .3s ease-out; }
  [data-active="true"] .read-letter { opacity: 1; transform: translateY(0); animation: readFloat 2.2s ease-in-out infinite; }
  .read-letter-1 { animation-delay: 0s !important; }
  .read-letter-2 { animation-delay: .3s !important; }
  .read-letter-3 { animation-delay: .6s !important; }
  @keyframes readFloat { 0%, 100% { transform: translateY(0); opacity: 1; } 50% { transform: translateY(-8px); opacity: .4; } }

  /* Нейрон-ка */
  .neuro-line { stroke: var(--stop-accent); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 6 18; }
  .neuro-node { fill: var(--stop-accent); }
  .neuro-soma { fill: var(--stop-accent-dark); }
  [data-active="true"] .neuro-line { animation: neuroPulse 1.1s linear infinite; }
  @keyframes neuroPulse { to { stroke-dashoffset: -24; } }
  [data-active="true"] .neuro-node { animation: neuroGlow 1.1s ease-in-out infinite; }
  @keyframes neuroGlow { 0%, 100% { r: 6; opacity: .8; } 50% { r: 8.5; opacity: 1; } }

  /* Песчинка */
  .sand-sun { fill: color-mix(in srgb, var(--stop-accent) 55%, white); opacity: .8; }
  .sand-dune-back { fill: color-mix(in srgb, var(--stop-accent) 30%, white); }
  .sand-dune-front { fill: var(--stop-accent); }
  .sand-grain { fill: var(--stop-accent-dark); opacity: 0; transition: opacity .3s ease-out; }
  [data-active="true"] .sand-grain { opacity: .7; animation: sandJitter 1.8s ease-in-out infinite; }
  .sand-grain:nth-of-type(1) { animation-delay: 0s !important; }
  .sand-grain:nth-of-type(2) { animation-delay: .2s !important; }
  .sand-grain:nth-of-type(3) { animation-delay: .4s !important; }
  .sand-grain:nth-of-type(4) { animation-delay: .6s !important; }
  @keyframes sandJitter { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(3px) translateX(2px); } }

  /* Рисовалка */
  .draw-line {
    fill: none;
    stroke: var(--stop-accent-dark);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
    opacity: .38;
    transition: opacity .4s ease-out, stroke-width .4s ease-out;
  }
  .draw-tip { fill: var(--stop-accent); opacity: 0; transition: opacity .3s ease-out; }
  [data-active="true"] .draw-line { opacity: 1; stroke-width: 6; animation: drawRetrace 1s cubic-bezier(.22, 1, .36, 1); }
  [data-active="true"] .draw-tip { opacity: 1; transition-delay: .8s; }
  @keyframes drawRetrace { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }

  /* Разумей-ка */
  .logic-piece { fill: color-mix(in srgb, var(--stop-accent) 30%, white); stroke: var(--stop-accent-dark); stroke-width: 3; transition: transform .5s cubic-bezier(.34, 1.56, .64, 1); }
  .logic-piece-a { transform: translate(-10px, -6px) rotate(-6deg); }
  .logic-piece-b { transform: translate(10px, 6px) rotate(5deg); }
  [data-active="true"] .logic-piece-a,
  [data-active="true"] .logic-piece-b { transform: translate(0, 0) rotate(0deg); }
  .logic-rays { stroke: var(--stop-accent); stroke-width: 3; stroke-linecap: round; opacity: 0; transition: opacity .3s ease-out .3s; }
  [data-active="true"] .logic-rays { opacity: 1; animation: logicPulse 1.4s ease-in-out infinite .5s; }
  @keyframes logicPulse { 0%, 100% { opacity: .5; } 50% { opacity: 1; } }

  /* ===== Подвал секции ===== */
  .razvivayka-footer {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: var(--space-6);
    align-items: start;
  }

  .benefits h3 { font: var(--text-lead); font-size: 16px; color: var(--color-ink); margin-bottom: var(--space-4); }

  .duration-card {
    background: var(--color-surface);
    box-shadow: inset 0 0 0 var(--stroke-hairline) var(--color-mist);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .duration-value { font: var(--text-h3); color: var(--color-ink); margin-top: var(--space-2); }
  .duration-card p { margin-top: var(--space-2); font: var(--text-meta); color: var(--color-ink-soft); margin-bottom: var(--space-5); }

  /* ===== Адаптив ===== */
  @media (max-width: 1024px) {
    .razvivayka-sticker, .raz-doodle { display: none; }
    .section-head-illustration { display: none; }
  }

  @media (min-width: 901px) {
    .raz-panel-mobile { display: none; }
    .raz-stage { display: block; }
  }

  @media (max-width: 900px) {
    .raz-route-stops { flex-direction: column; gap: 0; }
    .raz-route-line { left: 22px; top: 22px; bottom: 22px; right: auto; width: var(--stroke-bold); height: auto; }
    .raz-route-line-fill { width: 100%; height: 100%; transform: scaleY(0); transform-origin: top; transition: transform .8s cubic-bezier(.22, 1, .36, 1); }
    .raz-route.is-filled .raz-route-line-fill { transform: scaleY(1); }

    .raz-stop { flex-direction: row; align-items: center; text-align: left; gap: var(--space-4); padding: var(--space-3) 0; }
    .raz-stop-meta { flex-direction: row; align-items: baseline; gap: var(--space-3); }

    .raz-panel-mobile .raz-panel-inner { padding-left: 60px; }
  }

  @media (max-width: 780px) {
    .razvivayka-footer { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .raz-blob { display: none; }
    .raz-panel-mobile .raz-panel-inner { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
    .raz-panel-mobile .raz-panel-visual { width: 96px; height: 96px; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-raz-reveal] { transition: opacity .3s ease-out; transform: none; }
    .razvivayka-star, .razvivayka-heart, .raz-doodle { animation: none !important; }
    .raz-stop-dot, .raz-panel, .raz-panel-mobile, .raz-route-line-fill { transition-duration: .15s !important; }
    .raz-stop[aria-selected="true"] .raz-stop-dot { transform: none; }
    .raz-panel { filter: none !important; transform: none !important; }
    .read-letter, .neuro-line, .neuro-node, .sand-grain, .logic-rays { animation: none !important; }
    [data-active="true"] .read-letter { opacity: 1; transform: none; }
  }
</style>

<script>
  const section = document.getElementById('razvivayka') as HTMLElement | null;
  const route = document.getElementById('raz-route') as HTMLElement | null;
  const bg = document.getElementById('raz-bg');
  if (!section || !route) throw new Error('razvivayka section missing');

  const hues = [108, 265, 30, 205, 168];
  const stops = Array.from(route.querySelectorAll<HTMLButtonElement>('.raz-stop'));
  const desktopPanels = Array.from(route.querySelectorAll<HTMLElement>('.raz-panel'));
  const mobilePanels = Array.from(route.querySelectorAll<HTMLElement>('.raz-panel-mobile'));

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function setActive(index: number) {
    stops.forEach((el, i) => {
      const active = i === index;
      el.setAttribute('aria-selected', String(active));
      el.setAttribute('tabindex', active ? '0' : '-1');
    });
    desktopPanels.forEach((el, i) => {
      el.dataset.active = String(i === index);
      el.setAttribute('aria-hidden', String(i !== index));
    });
    mobilePanels.forEach((el, i) => {
      el.dataset.active = String(i === index);
      el.setAttribute('aria-hidden', String(i !== index));
    });
    section!.style.setProperty('--active-hue', String(hues[index]));
  }

  stops.forEach((el, i) => {
    el.addEventListener('mouseenter', () => setActive(i));
    el.addEventListener('focusin', () => setActive(i));
    el.addEventListener('click', () => setActive(i));

    el.addEventListener('keydown', (e) => {
      const key = e.key;
      let next: number | null = null;
      if (key === 'ArrowRight' || key === 'ArrowDown') next = (i + 1) % stops.length;
      else if (key === 'ArrowLeft' || key === 'ArrowUp') next = (i - 1 + stops.length) % stops.length;
      else if (key === 'Home') next = 0;
      else if (key === 'End') next = stops.length - 1;
      if (next === null) return;
      e.preventDefault();
      setActive(next);
      stops[next].focus();
    });
  });

  // Не нужно ничего кликать, чтобы увидеть все 5 станций — переключение
  // привязано напрямую к скроллу.
  //
  // Десктоп: .raz-route-pin «прилипает» под хедером, пока .raz-route (у которого
  // JS выставляет большую высоту — по одному «шагу» на станцию) прокручивается
  // мимо. Прогресс скролла внутри этого шага и выбирает активную станцию —
  // ровно как просил пользователь: «экран на месте, пока скролишь — открываются».
  //
  // Мобила: там станции и так идут одна под другой (обычный вертикальный
  // список), поэтому вместо pin — каждая раскрывается сама, когда доезжает до
  // средней трети экрана.
  if (!reduceMotion) {
    const pin = document.getElementById('raz-route-pin') as HTMLElement | null;
    const desktopMql = window.matchMedia('(min-width: 901px)');
    const PIN_OFFSET = 100; // должен совпадать с top в CSS у .raz-route-pin
    const STEP_VH_RATIO = 0.62; // «протяжённость» одной станции в долях высоты экрана
    const MOBILE_FOCUS_RATIO = 0.4; // линия во вьюпорте, к которой «магнитится» ближайшая станция

    let mode: 'desktop' | 'mobile' | null = null;
    let raf = 0;

    function layoutDesktopTrack() {
      if (!pin) return;
      const step = window.innerHeight * STEP_VH_RATIO;
      route!.style.height = `${pin.offsetHeight + step * stops.length}px`;
    }

    function updateDesktop() {
      if (!pin) return;
      const rect = route!.getBoundingClientRect();
      const scrollable = rect.height - pin.offsetHeight;
      if (scrollable <= 0) return;
      const traveled = PIN_OFFSET - rect.top;
      const progress = Math.min(1, Math.max(0, traveled / scrollable));
      setActive(Math.min(stops.length - 1, Math.floor(progress * stops.length)));
    }

    // Раньше тут был IntersectionObserver по каждой кнопке — но при обычном
    // быстром свайпе несколько станций пересекают его зону почти одновременно
    // одним пакетом событий, и «побеждала» не та, что реально в фокусе, а
    // последняя по DOM-порядку — отсюда хаотичное поведение на телефоне.
    // Вместо этого на каждый скролл просто берём одну станцию, чья кнопка
    // ближе всего к «линии фокуса» — детерминированно, без гонки состояний.
    function updateMobile() {
      const line = window.innerHeight * MOBILE_FOCUS_RATIO;
      let bestIndex = 0;
      let bestDist = Infinity;
      stops.forEach((el, i) => {
        const r = el.getBoundingClientRect();
        const dist = Math.abs(r.top + r.height / 2 - line);
        if (dist < bestDist) {
          bestDist = dist;
          bestIndex = i;
        }
      });
      setActive(bestIndex);
    }

    function onScroll() {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        if (mode === 'desktop') updateDesktop();
        else if (mode === 'mobile') updateMobile();
      });
    }

    function enterDesktopMode() {
      mode = 'desktop';
      layoutDesktopTrack();
      window.addEventListener('resize', layoutDesktopTrack);
      updateDesktop();
    }

    function enterMobileMode() {
      mode = 'mobile';
      window.removeEventListener('resize', layoutDesktopTrack);
      route!.style.height = '';
      updateMobile();
    }

    function applyMode() {
      if (desktopMql.matches) enterDesktopMode();
      else enterMobileMode();
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    applyMode();
    desktopMql.addEventListener('change', applyMode);
  }

  // Линия маршрута заливается по мере попадания секции во вьюпорт (та же механика,
  // что у остальных таймлайнов сайта)
  const lineObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          route!.classList.add('is-filled');
          lineObserver.disconnect();
        }
      });
    },
    { threshold: 0.4 }
  );
  lineObserver.observe(route);

  // Стаггер-появление блоков
  const revealEls = Array.from(section.querySelectorAll<HTMLElement>('[data-raz-reveal]'));
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const order = Number(el.dataset.razReveal || '0');
        setTimeout(() => el.classList.add('is-shown'), order * 70);
        revealObserver.unobserve(el);
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );
  revealEls.forEach((el) => revealObserver.observe(el));

  // Лёгкий параллакс фона по курсору — только десктоп
  const isDesktopHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (bg && isDesktopHover && !reduceMotion) {
    let raf = 0;
    section.addEventListener('mousemove', (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        const rect = section!.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        bg.style.transform = `translate(${x * 10}px, ${y * 10}px)`;
        raf = 0;
      });
    });
    section.addEventListener('mouseleave', () => {
      bg.style.transform = 'translate(0, 0)';
    });
  }
</script>
