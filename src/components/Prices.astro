---
import { prices } from '../data/content';
import Icon from './Icon.astro';
---

<section class="prices section" id="prices">
  <div class="container">
    <div class="section-head center" data-reveal>
      <span class="eyebrow">Цены</span>
      <h2>Прайс студии «Сензитивность»</h2>
      <p>Прозрачные цены без скрытых платежей · оплата абонементом.</p>
    </div>

    <div class="prices-grid" data-reveal>
      <div class="price-block">
        <span class="block-label">Групповые программы</span>
        <div class="price-cards">
          {prices.group.map((item) => (
            <div class="price-card" class:list={[{ 'price-card--clay': item.icon === 'price-sand' }]}>
              <Icon name={item.icon} class="price-icon" />
              <h3>{item.title}</h3>
              <span class="price-age">{item.ageLabel}</span>
              <div class="price-tiers">
                {item.tiers.map((t) => (
                  <div class="price-tier">
                    <span class="tier-price">{t.price}</span>
                    <span class="tier-note">{t.note}</span>
                  </div>
                ))}
              </div>
              {item.schedule && <span class="price-schedule">{item.schedule}</span>}
            </div>
          ))}
        </div>
      </div>

      <div class="price-block">
        <span class="block-label">Индивидуально</span>
        <div class="price-table">
          {prices.individual.map((item) => (
            <div class="price-row">
              <div>
                <h3>{item.title}</h3>
                <span class="price-age">{item.ageLabel}</span>
              </div>
              <span class="row-price">{item.price}</span>
            </div>
          ))}
        </div>

        <div class="diagnostics-card">
          <h3>{prices.diagnostics.title}</h3>
          <p>{prices.diagnostics.sub}</p>
          <div class="diagnostics-price">
            <span class="row-price">{prices.diagnostics.price}</span>
            <span class="price-age">{prices.diagnostics.note}</span>
          </div>
          <a href="#booking" class="btn btn-primary">Записаться на диагностику</a>
        </div>
      </div>
    </div>

    <blockquote class="prices-tagline" data-reveal>
      <p>«{prices.tagline.quote}»</p>
      <cite>{prices.tagline.signoff}</cite>
    </blockquote>
  </div>
</section>

<style>
  .prices-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-6); align-items: start; }

  .block-label { display: block; font: var(--text-label); letter-spacing: var(--tracking-label); color: var(--color-ink-soft); margin-bottom: var(--space-4); }

  .price-cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }

  .price-card {
    background: var(--color-surface);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .price-card :global(.price-icon) { color: var(--color-moss); }
  .price-card h3 { font: var(--text-lead); font-size: 16.5px; margin-top: var(--space-2); }
  .price-age { font: var(--text-meta); font-size: 13px; color: var(--color-ink-soft); }

  /* Единственная карточка про песок и глину — тёплый нейтральный акцент вместо холодной зелени */
  .price-card--clay { background: color-mix(in srgb, var(--color-clay) 7%, var(--color-surface)); }
  .price-card--clay :global(.price-icon) { color: var(--color-clay); }

  .price-tiers { margin-top: var(--space-3); display: flex; gap: var(--space-4); }
  .price-tier { display: flex; flex-direction: column; }
  .tier-price { font: var(--text-h3); font-size: 20px; color: var(--color-ink); }
  .tier-note { font: var(--text-meta); font-size: 12.5px; color: var(--color-ink-soft); }
  .price-schedule { margin-top: var(--space-2); font: var(--text-meta); font-size: 13px; color: var(--color-ink-soft); }

  .price-table {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-mist);
  }

  .price-row:last-child { border-bottom: none; }
  .price-row h3 { font: var(--text-meta); font-weight: 700; color: var(--color-ink); }
  .row-price { flex-shrink: 0; font: var(--text-lead); font-weight: 700; color: var(--color-moss); }

  .diagnostics-card {
    margin-top: var(--space-5);
    background: var(--color-moss);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .diagnostics-card h3 { color: #fff; font: var(--text-lead); font-size: 16px; }
  .diagnostics-card p { margin-top: var(--space-2); font: var(--text-meta); color: rgba(255,255,255,.75); }
  .diagnostics-card .price-age { color: rgba(255,255,255,.75); }
  .diagnostics-price { margin-top: var(--space-4); display: flex; align-items: baseline; gap: var(--space-3); }
  .diagnostics-price .row-price { color: var(--color-lime); }
  .diagnostics-card .btn { margin-top: var(--space-5); background: #fff; color: var(--color-ink); }
  .diagnostics-card .btn:hover { background: var(--color-lime); }

  .prices-tagline { margin: var(--space-8) auto 0; max-width: 640px; text-align: center; }
  .prices-tagline p { font: var(--text-h3); font-style: italic; color: var(--color-ink); }
  .prices-tagline cite { display: block; margin-top: var(--space-3); font-style: normal; font: var(--text-meta); color: var(--color-ink-soft); }

  @media (max-width: 900px) {
    .prices-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .price-cards { grid-template-columns: 1fr; }
  }
</style>
