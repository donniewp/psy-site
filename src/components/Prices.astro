---
/*
  Прайс стоит сразу под карточками программ и собирается из того же массива
  `programs` — ни одной цены, написанной здесь руками. Раньше это был второй
  рукописный список тех же услуг, и он молча разъезжался с карточками: у
  «Песка и глины» в таблице стоял возраст 4–7, а на карточке 6–8.

  Форма намеренно противоположна карточкам: там фотографии и воздух, здесь
  плотная типографика и колонка цифр, выровненная по правому краю, — по такой
  колонке цену находят взглядом за секунду, по восьми карточкам с фото нет.
*/
import { programs, prices, trialOffer } from '../data/content';
import Icon from './Icon.astro';

const groupPrograms = programs.filter((p) => !p.groups.includes('individualno'));
const individualPrograms = programs.filter((p) => p.groups.includes('individualno'));
---

<section class="pricelist section-tight" id="prices">
  <div class="container">
    <div class="pricelist-head" data-reveal>
      <span class="eyebrow">Цены</span>
      <h2>Сколько стоит заниматься</h2>
      <p>Оплата абонементом, без скрытых платежей и вступительных взносов.</p>
    </div>

    <div class="pricelist-panel" data-reveal>
      <span class="pricelist-label">Занятия в группе</span>
      {groupPrograms.map((p) => (
        <div class="pricelist-row">
          <div class="pricelist-what">
            <span class="pricelist-name">{p.title}</span>
            <span class="pricelist-format">{p.subtitle}</span>
            <span class="pricelist-meta">{p.ageLabel} · {p.sessionInfo}{p.schedule ? ` · ${p.schedule}` : ''}</span>
          </div>
          <div class="pricelist-cost">
            <span class="pricelist-price">{p.price}</span>
            {p.individual && <span class="pricelist-extra">{p.individual}</span>}
          </div>
        </div>
      ))}

      <span class="pricelist-label">Индивидуально</span>
      {individualPrograms.map((p) => (
        <div class="pricelist-row">
          <div class="pricelist-what">
            <span class="pricelist-name">{p.title}</span>
            <span class="pricelist-format">{p.subtitle}</span>
            <span class="pricelist-meta">{p.ageLabel} · {p.sessionInfo}</span>
          </div>
          <div class="pricelist-cost">
            <span class="pricelist-price">{p.price}</span>
          </div>
        </div>
      ))}

      <div class="pricelist-trial">
        <span class="pricelist-trial-badge">
          <Icon name="svc-check" class="pricelist-trial-icon" />
          {trialOffer.short}
        </span>
        <span class="pricelist-trial-note">Знакомство со студией и педагогом ничего не стоит и ни к чему не обязывает.</span>
        <a href="#booking" class="btn btn-primary pricelist-trial-cta">Записаться на пробное</a>
      </div>
    </div>

    <blockquote class="prices-tagline" data-reveal>
      <p>«{prices.tagline.quote}»</p>
      <cite>{prices.tagline.signoff}</cite>
    </blockquote>
  </div>
</section>

<style>
  .pricelist-head { max-width: 640px; margin: 0 auto var(--space-5); text-align: center; }
  .pricelist-head .eyebrow { justify-content: center; }
  .pricelist-head h2 { margin-top: var(--space-3); font: var(--text-h2); letter-spacing: var(--tracking-display); }
  .pricelist-head p { margin-top: var(--space-3); font: var(--text-body); color: var(--color-ink-soft); }

  .pricelist-panel {
    max-width: 860px;
    margin: 0 auto;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--space-5) var(--space-6) var(--space-6);
  }

  .pricelist-label {
    display: block;
    margin: var(--space-5) 0 var(--space-2);
    font: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-ink-soft);
  }

  .pricelist-label:first-child { margin-top: 0; }

  .pricelist-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-5);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-top: var(--stroke-hairline) solid color-mix(in srgb, var(--color-mist) 40%, transparent);
  }

  .pricelist-what { display: flex; flex-direction: column; gap: 2px; }

  .pricelist-name { font: var(--text-lead); font-size: 17px; color: var(--color-ink); }
  .pricelist-format { font: var(--text-meta); font-size: 13.5px; font-weight: 600; color: var(--color-moss); }
  .pricelist-meta { margin-top: 2px; font: var(--text-meta); font-size: 13px; color: var(--color-ink-soft); }

  .pricelist-cost { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }

  /* Цифры моноширинные по ширине знака: иначе колонка цен «пляшет» и перестаёт
     читаться сверху вниз одним взглядом — ради этого таблица и существует. */
  .pricelist-price {
    font: var(--text-meta);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .pricelist-extra {
    font: var(--text-meta);
    font-size: 12.5px;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  /* Пробное — последняя строка денежного разговора, поэтому она внизу и на
     единственном акцентном цвете сайта. */
  .pricelist-trial {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: var(--stroke-thin) solid color-mix(in srgb, var(--color-moss) 25%, transparent);
  }

  .pricelist-trial-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-lime);
    font: var(--text-meta);
    font-weight: 700;
    color: var(--color-ink);
  }

  .pricelist-trial-badge :global(.pricelist-trial-icon) { width: 15px; height: 15px; flex-shrink: 0; }

  .pricelist-trial-note { flex: 1; min-width: 220px; font: var(--text-meta); color: var(--color-ink-soft); }
  .pricelist-trial-cta { flex-shrink: 0; }

  .prices-tagline {
    max-width: 640px;
    margin: var(--space-6) auto 0;
    text-align: center;
    font-family: var(--font-display);
  }

  .prices-tagline p { font: var(--text-h3); font-style: italic; color: var(--color-ink); }
  .prices-tagline cite { display: block; margin-top: var(--space-3); font: var(--text-meta); font-style: normal; color: var(--color-ink-soft); }

  @media (max-width: 620px) {
    .pricelist-panel { padding: var(--space-4) var(--space-4) var(--space-5); }

    /* На телефоне цена уходит под название: в две колонки строка ужимается до
       трёх слов на строку и перестаёт читаться. */
    .pricelist-row { grid-template-columns: 1fr; gap: var(--space-2); }
    .pricelist-cost { align-items: flex-start; }
    .pricelist-price, .pricelist-extra { text-align: left; white-space: normal; }
    .pricelist-trial-cta { width: 100%; }
  }
</style>
