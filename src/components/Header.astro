---
import { nav, phone, phoneHref } from '../data/content';
import FigmaAsset from './FigmaAsset.astro';
const { bookingLabel = 'Записаться' } = Astro.props;
const prefix = Astro.url.pathname === '/' ? '' : '/';
---
<header class="header" id="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Сензитивность — на главную">
      <span class="logo-mark"><FigmaAsset src="logo/logo-sign.svg" /></span>
      <span class="logo-text">СЕНЗИТИВНОСТЬ<span class="logo-sub">детская студия развития</span></span>
    </a>
    <nav class="nav-desktop" aria-label="Основная навигация">{nav.map(item => <a href={`${prefix}#${item.id}`}>{item.label}</a>)}</nav>
    <div class="header-right">
      <a href={phoneHref} class="phone">{phone}</a>
      <a href="#booking" class="btn btn-primary header-cta">{bookingLabel}</a>
      <button class="burger" id="burger-btn" aria-label="Открыть меню" aria-controls="mobile-menu" aria-expanded="false"><span></span><span></span></button>
    </div>
  </div>
</header>
<dialog class="mobile-menu" id="mobile-menu" aria-label="Меню сайта">
  <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Закрыть меню">×</button>
  <nav aria-label="Мобильная навигация">{nav.map(item => <a href={`${prefix}#${item.id}`}>{item.label}</a>)}</nav>
  <a href={phoneHref} class="menu-phone">{phone}</a>
  <a href="#booking" class="btn btn-primary">{bookingLabel}</a>
</dialog>
<style>
  .header { position: sticky; top: 0; z-index: 100; background: color-mix(in srgb, var(--color-paper) 90%, transparent); backdrop-filter: blur(10px); box-shadow: var(--shadow-sm); }
  .header-inner { height: 80px; display: flex; justify-content: space-between; align-items: center; gap: var(--space-5); }
  .logo { display: flex; gap: var(--space-3); align-items: center; white-space: nowrap; }
  .logo-mark { width: 30px; height: 34px; color: var(--color-moss); }
  .logo-mark :global(svg) { width: 100%; height: 100%; }
  .logo-text { font: 600 20px/1.5 var(--font-display); color: var(--color-ink); letter-spacing: .03em; }
  .logo-sub { display: block; font: 400 12px/1.4 var(--font-text); color: var(--color-ink-soft); letter-spacing: 0; }
  .nav-desktop { display: flex; gap: var(--space-5); }
  .nav-desktop a, .phone { font: var(--text-meta); font-size: 14px; white-space: nowrap; padding: var(--space-3) 0; }
  .nav-desktop a:hover { color: var(--color-moss); text-decoration: underline; text-underline-offset: 6px; }
  .header-right { display: flex; align-items: center; gap: var(--space-5); }
  .phone { color: var(--color-ink); font-weight: 700; }
  .header-cta { padding: var(--space-3) var(--space-5); }
  .burger { display: none; width: 44px; height: 44px; align-items: center; justify-content: center; flex-direction: column; gap: 6px; }
  .burger span { width: 22px; height: 1px; background: var(--color-ink); }
  .mobile-menu { border: none; background: var(--color-paper); color: var(--color-ink); width: min(420px, calc(100% - 32px)); padding: var(--space-8) var(--space-5) var(--space-6); border-radius: var(--radius-md); max-height: calc(100dvh - 32px); }
  .mobile-menu::backdrop { background: rgb(34 86 77 / .5); }
  .mobile-menu-close { position: absolute; right: var(--space-3); top: var(--space-3); width: 44px; height: 44px; font-size: 30px; color: var(--color-ink); }
  .mobile-menu nav { display: grid; margin-bottom: var(--space-5); }
  .mobile-menu nav a { font: var(--text-h3); font-size: 23px; padding: var(--space-3) 0; border-bottom: 1px solid var(--color-divider); }
  .menu-phone { display: block; margin-bottom: var(--space-5); }
  @media (max-width: 1180px) { .nav-desktop, .header-right .phone, .header-cta { display: none; } .burger { display: flex; } }
  @media (max-width: 600px) { .header-inner { height: 72px; gap: var(--space-2); } .logo-text { font-size: 17px; } .logo-mark { width: 25px; } .logo { gap: var(--space-2); } }
  .logo-mark { transition: transform .35s cubic-bezier(.34, 1.56, .64, 1); }
  .logo:hover .logo-mark { transform: rotate(-8deg) scale(1.12); }
  .nav-desktop a { position: relative; }
  .nav-desktop a::after { content: ''; position: absolute; width: 9px; height: 9px; top: 0; right: -10px; background: var(--color-lime); clip-path: polygon(50% 0%, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0% 50%, 39% 39%); opacity: 0; transform: scale(.3) rotate(-30deg); transition: opacity .25s ease-out, transform .35s ease-out; }
  .nav-desktop a:hover::after { opacity: 1; transform: scale(1) rotate(0); }
</style>
<script>
  const menu = document.getElementById('mobile-menu') as HTMLDialogElement;
  const burger = document.getElementById('burger-btn');
  burger?.addEventListener('click', () => { menu.showModal(); burger.setAttribute('aria-expanded', 'true'); document.body.style.overflow = 'hidden'; });
  menu?.addEventListener('close', () => {
    burger?.setAttribute('aria-expanded', 'false');
    if (!document.querySelector('dialog[open]')) document.body.style.overflow = '';
  });
  document.getElementById('mobile-menu-close')?.addEventListener('click', () => menu.close());
  menu?.addEventListener('click', e => { if (e.target === menu || (e.target as Element).closest('a')) menu.close(); });
</script>
