---
import { phone, phoneHref, telegramHref, maxHref, location } from '../data/content';
import Icon from './Icon.astro';
const { diagnostic = false, consultation = false, mobile = true } = Astro.props;
---
<div class:list={['contact-rail', { 'desktop-only': !mobile }]}>
  <details class="contact-choices" id="contact-choices">
    <summary>
      <span class="contact-icons" aria-hidden="true"><span><Icon name="svc-telegram" /></span><span><Icon name="svc-max" /></span></span>
      <span class="contact-label"><span class="label-full">Задать вопрос</span><span class="label-short">Написать</span></span>
    </summary>
    <div class="contact-panel">
      <p>Как вам удобнее?</p>
      <a href={telegramHref} target="_blank" rel="noopener"><span class="choice-icon" aria-hidden="true"><Icon name="svc-telegram" /></span>Написать в Telegram<span class="choice-arrow" aria-hidden="true">↗</span></a>
      <a href={maxHref} target="_blank" rel="noopener"><span class="choice-icon" aria-hidden="true"><Icon name="svc-max" /></span>Написать в MAX<span class="choice-arrow" aria-hidden="true">↗</span></a>
      <a href={phoneHref}><span class="choice-icon" aria-hidden="true"><Icon name="svc-phone" /></span>{phone}</a>
      <small>Студия открыта {location.hours}</small>
    </div>
  </details>
  <a href="#booking" class="btn btn-primary sticky-book">{diagnostic ? 'На диагностику' : consultation ? 'Обсудить встречу' : 'Пробное бесплатно'}</a>
</div>
<style>
  .contact-rail { position: fixed; right: var(--space-5); bottom: var(--space-5); z-index: 95; }
  .contact-choices { position: relative; }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: var(--space-3); min-height: 56px; padding: var(--space-2) var(--space-5) var(--space-2) var(--space-2); color: var(--color-ink); background: var(--color-surface); border-radius: var(--radius-pill); box-shadow: var(--shadow-md); font: var(--text-meta); font-weight: 700; font-size: 16px; transition: transform .2s ease-out, box-shadow .2s ease-out; }
  summary:hover { transform: translateY(-2px); box-shadow: var(--shadow-lift); }
  .contact-icons { display: flex; }
  .contact-icons > span { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--radius-circle); background: var(--color-moss); color: #fff; box-shadow: 0 0 0 2px var(--color-surface); }
  .contact-icons > span + span { margin-left: calc(var(--space-2) * -1); background: var(--color-moss-deep); }
  .contact-icons :global(.icon) { width: 20px; height: 20px; }
  .label-short { display: none; }
  summary::-webkit-details-marker { display: none; }
  .contact-choices[open] summary { background: var(--color-paper); transform: none; }
  .contact-panel { position: absolute; bottom: calc(100% + 12px); right: 0; width: 300px; background: var(--color-surface); border-radius: var(--radius-sm); box-shadow: var(--shadow-md); padding: var(--space-5); }
  .contact-panel p { color: var(--color-ink); font-weight: 600; margin-bottom: var(--space-2); }
  .contact-panel a { display: flex; align-items: center; gap: var(--space-3); min-height: 52px; border-bottom: 1px solid var(--color-divider); font: var(--text-meta); color: var(--color-ink); }
  .choice-icon { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; flex-shrink: 0; border-radius: var(--radius-circle); background: var(--color-paper); color: var(--color-moss); }
  .choice-icon :global(.icon) { width: 18px; height: 18px; }
  .choice-arrow { margin-left: auto; color: var(--color-moss); }
  .contact-panel a:hover { color: var(--color-moss); }
  small { display: block; font-size: 12px; line-height: 1.5; margin-top: var(--space-3); }
  .sticky-book { display: none; }
  @media (max-width: 720px) {
    .contact-rail.desktop-only { display: none; }
    .contact-rail { left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 1fr 1.2fr; gap: var(--space-3); padding: var(--space-3) var(--space-4); padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--color-divider); background: var(--color-surface); }
    .sticky-book { display: inline-flex; padding: var(--space-3); font-size: 14px; }
    summary { min-height: 48px; padding: var(--space-1) var(--space-3) var(--space-1) var(--space-1); gap: var(--space-2); font-size: 14px; box-shadow: none; border: 1px solid var(--color-mist); }
    summary:hover { transform: none; box-shadow: none; }
    .contact-icons > span { width: 36px; height: 36px; }
    .contact-icons :global(.icon) { width: 18px; height: 18px; }
    .label-full { display: none; }
    .label-short { display: inline; }
    .contact-panel { left: 0; right: auto; width: min(320px, calc(100vw - 32px)); }
  }
</style>
<script>
  const contacts = document.getElementById('contact-choices') as HTMLDetailsElement | null;
  document.addEventListener('click', e => { if (contacts?.open && !contacts.contains(e.target as Node)) contacts.open = false; });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && contacts?.open) { contacts.open = false; contacts.querySelector('summary')?.focus(); } });
</script>
