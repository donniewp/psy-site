---
import { phoneHref } from '../data/content';
import Icon from './Icon.astro';
const { diagnostic = false } = Astro.props;
---

<div class="sticky-cta">
  <a href={phoneHref} class="sticky-call" aria-label="Позвонить">
    <Icon name="svc-phone" class="sticky-icon" />
    Позвонить
  </a>
  <a href="#booking" class="btn btn-primary sticky-book">{diagnostic ? 'Запись на диагностику' : 'Пробное бесплатно'}</a>
</div>

<style>
  .sticky-cta {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 95;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    padding: var(--space-3) var(--space-4);
    padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
    gap: var(--space-3);
  }

  .sticky-call {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0 10px;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 var(--stroke-hairline) var(--color-mist);
    font: var(--text-meta);
    font-weight: 600;
    color: var(--color-ink);
  }

  .sticky-call :global(.sticky-icon) { width: 16px; height: 16px; color: var(--color-moss); }

  .sticky-book { flex: 1; padding: 13px 8px; font-size: 14px; }

  @media (max-width: 720px) {
    .sticky-cta { display: flex; }
  }
</style>
