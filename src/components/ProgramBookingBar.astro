---
import type { ProgramPage } from '../data/programPages';
const { href, action, bar } = Astro.props as { href: string; action: string; bar: ProgramPage['bar'] };
---
<div class="program-booking-bar" id="program-booking-bar" hidden>
  <div class="bar-price" data-group-offer><strong>{bar.price} <span>{bar.unit ?? '/ занятие'}</span></strong><small>{bar.note}</small></div>
  {bar.individual && <div class="bar-price" data-individual-offer hidden><strong>{bar.individual.price} <span>/ занятие</span></strong><small>{bar.individual.note}</small></div>}
  <a class="btn btn-primary" href={href} data-program-cta>{action}</a>
</div>
<style>
  .program-booking-bar { display: none; }
  @media (max-width: 720px) {
    .program-booking-bar:not([hidden]) { position: fixed; bottom: 0; left: 0; right: 0; z-index: 95; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-3) var(--space-5) calc(var(--space-3) + env(safe-area-inset-bottom, 0px)); border-top: var(--stroke-hairline) solid var(--color-divider); background: var(--color-surface); }
    :global(body:has(dialog[open])) .program-booking-bar { display: none; }
    .bar-price { font: var(--text-meta); text-align: center; }
    .bar-price strong { color: var(--color-ink); }
    .bar-price strong span { font-weight: 400; }
    .bar-price small { display: block; font-size: 12px; line-height: 1.4; }
    .btn { min-height: 48px; padding: var(--space-3); font-size: 14px; }
    :global(body:has(#program-booking-bar)) { padding-bottom: calc(132px + env(safe-area-inset-bottom, 0px)); scroll-padding-bottom: 132px; }
    :global(html:has(#program-booking-bar)) { scroll-padding-bottom: 132px; }
  }
</style>
<script>
  const bar = document.getElementById('program-booking-bar');
  const heroCta = document.querySelector('[data-hero-cta]') || document.querySelector('.program-intro [data-program-cta]');
  const header = document.getElementById('site-header');
  if (bar && heroCta) {
    let pending = false;
    const update = () => {
      pending = false;
      const passedHero = heroCta.getBoundingClientRect().bottom <= (header?.getBoundingClientRect().bottom ?? 0);
      bar.hidden = !passedHero || !!document.querySelector('dialog[open]');
    };
    const schedule = () => {
      if (!pending) { pending = true; requestAnimationFrame(update); }
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    new ResizeObserver(schedule).observe(heroCta);
    document.querySelectorAll('dialog').forEach(dialog => {
      new MutationObserver(schedule).observe(dialog, { attributes: true, attributeFilter: ['open'] });
    });
    update();
  }
</script>
