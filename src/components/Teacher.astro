---
import { specialist, teacherAchievements } from '../data/content';
import Icon from './Icon.astro';
import FigmaAsset from './FigmaAsset.astro';
---

<section class="teacher section" id="teacher">
  <div class="container teacher-inner">
    <div class="teacher-media" data-reveal>
      <img src={`${import.meta.env.BASE_URL}img/portrait.jpg`} alt={specialist.fullName} />
      <p class="photo-caption">{specialist.fullName}</p>
    </div>

    <div class="teacher-copy" data-reveal>
      <span class="eyebrow">Знакомьтесь, наш педагог</span>
      <h2>{specialist.fullName}</h2>
      <p class="teacher-role">{specialist.credentials}</p>
      <p class="teacher-bio">{specialist.bio}</p>

      <div class="teacher-achievements">
        {teacherAchievements.map((a) => (
          <div class="achievement-card">
            <span class="achievement-illustration"><FigmaAsset src={a.illustration} /></span>
            <strong>{a.title}</strong>
            <span>{a.text}</span>
          </div>
        ))}
      </div>

      <div class="teacher-education">
        <h3>Образование и повышение квалификации</h3>
        <ul>
          {specialist.education.map((e) => (
            <li>
              <Icon name={e.icon} class="edu-icon" />
              <div>
                <strong>{e.program}</strong>
                <span>{e.institution}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="teacher-badge">
        <Icon name="svc-check" class="badge-icon" />
        <span>{specialist.badge}</span>
      </div>

      <div class="teacher-actions">
        <a href="#booking" class="btn btn-primary">Записаться к педагогу</a>
        <span class="teacher-tagline">{specialist.tagline}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .teacher-inner { display: grid; grid-template-columns: .75fr 1.25fr; gap: var(--space-7); align-items: start; }

  .teacher-media { position: sticky; top: calc(86px + var(--space-6)); }

  .teacher-media img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .teacher-role { margin-top: var(--space-2); font: var(--text-meta); font-weight: 600; color: var(--color-moss); }
  .teacher-bio { margin-top: var(--space-4); font: var(--text-body); max-width: 580px; }

  /* Числа из удалённой .stats-band переехали сюда двумя карточками + два новых пункта */
  .teacher-achievements {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .achievement-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--color-paper);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
  }

  .achievement-illustration { display: block; width: 48px; height: 48px; }
  .achievement-illustration :global(svg) { width: 100%; height: 100%; }

  .achievement-card strong { font: var(--text-meta); font-weight: 700; color: var(--color-ink); }
  .achievement-card span { font: var(--text-meta); font-size: 13px; color: var(--color-ink-soft); }

  .teacher-education { margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--color-mist); }
  .teacher-education h3 { font: var(--text-label); letter-spacing: var(--tracking-label); color: var(--color-ink-soft); }

  .teacher-education ul { margin: var(--space-4) 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4) var(--space-5); }
  .teacher-education li { display: flex; gap: var(--space-3); align-items: flex-start; }
  .teacher-education :global(.edu-icon) { color: var(--color-moss); flex-shrink: 0; margin-top: 2px; }
  .teacher-education strong { display: block; font: var(--text-meta); font-weight: 700; color: var(--color-ink); }
  .teacher-education span { font: var(--text-meta); font-size: 13.5px; color: var(--color-ink-soft); }

  .teacher-badge {
    margin-top: var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 var(--stroke-hairline) var(--color-mist);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    font: var(--text-meta);
    color: var(--color-ink);
  }

  .teacher-badge :global(.badge-icon) { color: var(--color-moss); flex-shrink: 0; }

  .teacher-actions { margin-top: var(--space-6); display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap; }
  .teacher-tagline { font: var(--text-meta); color: var(--color-ink-soft); font-style: italic; }

  @media (max-width: 900px) {
    .teacher-inner { grid-template-columns: 1fr; gap: var(--space-6); }
    /* На однoколоночной раскладке sticky больше не нужен — иначе портрет "прилипает"
       к верху и контент (включая новые карточки достижений) скроллится под ним */
    .teacher-media { position: static; top: auto; }
    .teacher-media img { max-width: 320px; margin: 0 auto; }
    .teacher-media .photo-caption { text-align: center; }
  }

  @media (max-width: 640px) {
    .teacher-achievements { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .teacher-education ul { grid-template-columns: 1fr; }
  }
</style>
