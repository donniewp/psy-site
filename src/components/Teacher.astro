---
import { specialist, teacherAchievements } from '../data/content';
import FigmaAsset from './FigmaAsset.astro';
---

<section class="teacher section" id="teacher">
  <div class="container teacher-inner">
    <div class="teacher-media" data-reveal>
      <img src={`${import.meta.env.BASE_URL}img/portrait.jpg`} width="1400" height="933" loading="lazy" decoding="async" alt={specialist.fullName} />
      <p class="photo-caption">{specialist.fullName}</p>
    </div>

    <div class="teacher-copy" data-reveal>
      <span class="eyebrow">Знакомьтесь, наш педагог</span>
      <h2>{specialist.fullName}</h2>
      <p class="teacher-role">{specialist.credentials}</p>
      <p class="teacher-bio">{specialist.bio}</p>

      <div class="teacher-achievements">
        {teacherAchievements.map((a) => (
          <div class="achievement-card">
            <span class="achievement-illustration"><FigmaAsset src={a.illustration} /></span>
            <strong>{a.title}</strong>
            <span>{a.text}</span>
          </div>
        ))}
      </div>

      <div class="teacher-education">
        <h3>Образование и повышение квалификации</h3>
        <ul>
          {specialist.education.map((e) => (
            <li class="edu-card">
              <span class="edu-art" aria-hidden="true">
                {/* Своя двухцветная картинка на каждое направление вместо одинаковых линейных иконок */}
                {e.icon === 'price-cap' && (
                  <svg viewBox="0 0 40 40"><circle cx="20" cy="17" r="7" class="fill" /><path d="M20 4v3M8.5 8.5l2.1 2.1M31.5 8.5l-2.1 2.1M4 17h3M33 17h3" /><path d="M6 33c4-5 9-7 14-7s10 2 14 7" /><path d="M20 26v-6m0 2c-2.5 0-4-1.5-4.5-3.5 2.5 0 4 1 4.5 3.5Zm0 0c2.5 0 4-1.5 4.5-3.5-2.5 0-4 1-4.5 3.5Z" /></svg>
                )}
                {e.icon === 'block-logic' && (
                  <svg viewBox="0 0 40 40"><rect x="5" y="6" width="17" height="12" rx="6" class="fill" /><path d="M11 18l-2 4 5-4" /><circle cx="27" cy="27" r="8" /><path d="M27 21v6l4 2" /><path d="M24 9h6a5 5 0 0 1 5 5v1m0 0-2-2m2 2 2-2" /></svg>
                )}
                {e.icon === 'block-sand' && (
                  <svg viewBox="0 0 40 40"><path d="M5 28c4-4 7-5 10-2s6 1 9-3 7-4 11 0v7H5Z" class="fill" /><rect x="4" y="20" width="32" height="14" rx="3" /><path d="M27 23V9l6 3-6 3" /><circle cx="13" cy="15" r="3" /></svg>
                )}
                {e.icon === 'block-read' && (
                  <svg viewBox="0 0 40 40"><path d="M19 8c-6-2-12 2-12 8-3 2-3 7 0 9 0 5 6 8 12 6Z" class="fill" /><path d="M19 8c-6-2-12 2-12 8-3 2-3 7 0 9 0 5 6 8 12 6V8Z" /><path d="M21 8c6-2 12 2 12 8 3 2 3 7 0 9 0 5-6 8-12 6V8Z" /><path d="M12 15c2 0 3 1 3 3M11 24c2 0 4-1 4-3M28 15c-2 0-3 1-3 3M29 24c-2 0-4-1-4-3" /></svg>
                )}
              </span>
              <div>
                <strong>{e.program}</strong>
                <span>{e.institution}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="teacher-badge">
        <span class="badge-medal" aria-hidden="true">
          <svg viewBox="0 0 48 48"><path d="M16 30 11 44l6-3 4 5 3-12M32 30l5 14-6-3-4 5-3-12" class="ribbon" /><circle cx="24" cy="20" r="14" class="disc" /><circle cx="24" cy="20" r="9.5" class="ring" /><path d="m19.5 20 3 3 6-6.5" class="tick" /></svg>
        </span>
        <span class="badge-text"><small>Статус педагога</small>{specialist.badge}</span>
      </div>

      <div class="teacher-actions">
        <a href="#booking" class="btn btn-primary">Записаться к педагогу</a>
        <span class="teacher-tagline">{specialist.tagline}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .teacher-inner { display: grid; grid-template-columns: .75fr 1.25fr; gap: var(--space-7); align-items: start; }

  .teacher-media { position: sticky; top: calc(86px + var(--space-6)); }

  .teacher-media img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .teacher-role { margin-top: var(--space-2); font: var(--text-meta); font-weight: 600; color: var(--color-moss); }
  .teacher-bio { margin-top: var(--space-4); font: var(--text-body); max-width: 580px; }

  /* Числа из удалённой .stats-band переехали сюда двумя карточками + два новых пункта */
  .teacher-achievements {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .achievement-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--color-paper);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
  }

  .achievement-illustration { display: block; width: 48px; height: 48px; }
  .achievement-illustration :global(svg) { width: 100%; height: 100%; }

  .achievement-card strong { font: var(--text-meta); font-weight: 700; color: var(--color-ink); }
  .achievement-card span { font: var(--text-meta); font-size: 13px; color: var(--color-ink-soft); }

  .teacher-education { margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--color-mist); }
  .teacher-education h3 { font: var(--text-label); letter-spacing: var(--tracking-label); color: var(--color-ink-soft); }

  .teacher-education ul { margin: var(--space-4) 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .edu-card {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 var(--stroke-hairline) color-mix(in srgb, var(--color-mist) 45%, transparent);
    border-radius: var(--radius-sm);
    transition: transform .2s ease-out, box-shadow .2s ease-out;
  }
  .edu-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .edu-art {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--color-lime) 38%, var(--color-paper));
  }
  .edu-art svg { width: 42px; height: 42px; fill: none; stroke: var(--color-moss); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .edu-art svg .fill { fill: var(--color-lime); stroke: none; }
  .teacher-education strong { display: block; font: 600 17px/1.25 var(--font-display); color: var(--color-ink); }
  .teacher-education span:not(.edu-art) { display: block; margin-top: 4px; font: var(--text-meta); font-size: 13.5px; line-height: 1.4; color: var(--color-ink-soft); }

  /* Подтверждённый статус — награда, а не ещё одна строка списка */
  .teacher-badge {
    margin-top: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    background: var(--color-moss-deep);
    border-radius: var(--radius-sm);
    padding: var(--space-4) var(--space-5);
    font: 600 17px/1.35 var(--font-display);
    color: #fff;
  }
  .badge-medal { flex-shrink: 0; width: 52px; height: 52px; }
  .badge-medal svg { width: 100%; height: 100%; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .badge-medal .ribbon { fill: color-mix(in srgb, var(--color-lime) 55%, var(--color-moss-deep)); }
  .badge-medal .disc { fill: var(--color-lime); }
  .badge-medal .ring { stroke: var(--color-moss-deep); stroke-width: 1.4; stroke-dasharray: 2 2.4; }
  .badge-medal .tick { stroke: var(--color-moss-deep); stroke-width: 2.6; }
  .badge-text small { display: block; margin-bottom: 2px; font: var(--text-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-lime); }

  .teacher-actions { margin-top: var(--space-6); display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap; }
  .teacher-tagline { font: var(--text-meta); color: var(--color-ink-soft); font-style: italic; }

  @media (max-width: 900px) {
    .teacher-inner { grid-template-columns: 1fr; gap: var(--space-6); }
    /* На однoколоночной раскладке sticky больше не нужен — иначе портрет "прилипает"
       к верху и контент (включая новые карточки достижений) скроллится под ним */
    .teacher-media { position: static; top: auto; }
    .teacher-media img { max-width: 320px; margin: 0 auto; }
    .teacher-media .photo-caption { text-align: center; }
  }

  @media (max-width: 640px) {
    .teacher-achievements { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .teacher-education ul { grid-template-columns: 1fr; }
  }
</style>
