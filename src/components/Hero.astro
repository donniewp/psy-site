---
import { location, heroBadges, trialOffer } from '../data/content';
import Icon from './Icon.astro';
---

<section class="hero" id="top">
  <div class="hero-blob" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <div class="hero-copy-head">
        <div class="hero-locations">
          <span class="loc-pill"><Icon name="svc-pin" class="loc-icon" />{location.address}</span>
          <span class="loc-pill"><Icon name="svc-metro" class="loc-icon" />{location.metro}</span>
        </div>

        <h1>Развитие, обучение и психологическая поддержка ребёнка</h1>
      </div>

      <div class="hero-copy-rest">
        <p class="hero-sub">
          От первых развивающих занятий до уверенного школьника и подростка.
          Педагогика · психология · нейропсихология.
        </p>

        <div class="hero-tags">
          <span class="tag">Педагог с опытом 20+ лет</span>
          <span class="tag tag-offer">{trialOffer.tag}</span>
        </div>

        <div class="hero-ctas">
          <a href="#booking" class="btn btn-primary">Записаться бесплатно</a>
          <a href="#programs" class="btn btn-secondary">Выбрать программу</a>
        </div>

        <p class="hero-microcopy">Познакомьтесь с педагогом и форматом занятий.<br />{trialOffer.timing}.</p>

        <a href="#video" class="hero-video-link">
          <span class="hero-video-link-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
          </span>
          Смотреть видео с занятий
        </a>
      </div>
    </div>

    <div class="hero-media" data-reveal>
      <div class="hero-img-wrap">
        <img src={`${import.meta.env.BASE_URL}img/hero.jpg`} width="1537" height="1023" alt="Татьяна Петрова занимается с детьми в студии «Сензитивность»" class="hero-img" fetchpriority="high" />
        {heroBadges.map((b, i) => (
          <div class:list={['floating-badge', i === 0 ? 'fb-1' : 'fb-2']}>
            <Icon name={b.icon} class="badge-icon" />
            <span>{b.text}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding: var(--space-6) 0 var(--space-6); }

  .hero-blob {
    position: absolute;
    top: -120px;
    right: -160px;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-lime) 55%, transparent), transparent 70%);
    animation: softpulse 6s ease-in-out infinite;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: var(--space-7);
    align-items: center;
  }

  .hero-locations { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-5); }

  .loc-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font: var(--text-meta);
    font-weight: 600;
    color: var(--color-moss);
    background: var(--color-surface);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
  }

  .loc-pill :global(.loc-icon) { width: 15px; height: 15px; }

  .hero h1 {
    font: var(--text-display);
    font-size: clamp(34px, 4.4vw, 54px);
    letter-spacing: var(--tracking-display);
  }

  .hero-sub { margin-top: var(--space-5); font: var(--text-lead); font-size: 21px; font-weight: 400; color: var(--color-ink-soft); max-width: 560px; }

  .hero-tags { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-top: var(--space-6); }

  .tag {
    font: var(--text-meta);
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-mist);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
  }

  .hero-ctas { display: flex; gap: var(--space-4); flex-wrap: wrap; margin-top: var(--space-6); }

  .tag-offer {
    background: var(--color-lime);
    box-shadow: none;
    color: var(--color-ink);
    font-weight: 700;
  }

  .hero-microcopy { margin-top: var(--space-4); font: var(--text-meta); color: var(--color-ink-soft); }

  .hero-video-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font: var(--text-meta);
    font-weight: 600;
    color: var(--color-moss);
    transition: gap .2s ease-out;
  }

  .hero-video-link-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 var(--stroke-thin) var(--color-moss);
    transition: background-color .2s ease-out, transform .2s ease-out;
  }

  .hero-video-link-icon svg { width: 11px; height: 11px; transform: translateX(1px); }

  .hero-video-link:hover { gap: var(--space-3); }
  .hero-video-link:hover .hero-video-link-icon,
  .hero-video-link:focus-visible .hero-video-link-icon { background: var(--color-moss); color: #fff; transform: scale(1.08); }
  .hero-video-link:focus-visible { outline: 2px solid var(--color-moss); outline-offset: 3px; border-radius: var(--radius-xs); }

  .hero-media { position: relative; }

  .hero-img-wrap { position: relative; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); }

  .hero-img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3.4;
    object-fit: cover;
    animation: kenburns 15s ease-in-out infinite alternate;
  }

  .floating-badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-surface);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    max-width: 152px;
    font: var(--text-meta);
    font-size: 12.5px;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .floating-badge :global(.badge-icon) { width: 17px; height: 17px; color: var(--color-moss); flex-shrink: 0; }

  .fb-1 { top: 14px; right: 14px; animation: floatY 5s ease-in-out infinite; }
  .fb-2 { bottom: 14px; left: 14px; max-width: 160px; animation: floatY2 6s ease-in-out infinite; }

  @media (max-width: 900px) {
    .hero { padding: 20px 0 32px; }
    .hero-inner { grid-template-columns: 1fr; gap: 24px; }
    .hero-locations { margin-bottom: 16px; gap: 6px; }
    .loc-pill { padding: 4px 0; background: transparent; font-size: 13px; }
    .hero h1 { font-size: clamp(30px, 7.8vw, 44px); line-height: 1.15; }
    .hero-sub { margin-top: 16px; font-size: 17px; line-height: 1.5; }
    .hero-tags { margin-top: 16px; gap: 6px; }
    .tag { font-size: 12px; padding: 7px 10px; }
    .hero-ctas { margin-top: 20px; gap: 10px; }
    .hero-ctas .btn { flex: 1 1 200px; padding: 13px 18px; }
    .hero-microcopy { margin-top: 12px; font-size: 13px; }
    .hero-video-link { margin-top: 12px; }
    .hero-img { aspect-ratio: 16 / 9; height: auto; animation: none; }
    .floating-badge { display: none; }
  }
</style>
