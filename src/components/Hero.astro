---
import { location, heroBadges, reviews, yandexMapsUrl, yandexRating, programs } from '../data/content';
import Icon from './Icon.astro';
import { heroImage } from '../data/heroImage';

// Самый дешёвый абонемент берём из карточек программ: вписанная сюда цифра
// тихо разойдётся с прайсом при первом же изменении цен.
const packs = programs.flatMap((p) => [...p.price.matchAll(/(\d[\d\s]*)\s₽\s\/\s(\d+)\sзанят/g)]
  .map((m) => ({ rub: Number(m[1].replace(/\s/g, '')), text: m[1].trim(), lessons: m[2] })));
const cheapest = packs.reduce((a, b) => (b.rub < a.rub ? b : a));
---

<section class="hero" id="top">
  <div class="hero-blob" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <div class="hero-copy-head">
        <p class="hero-where"><Icon name="svc-metro" class="loc-icon" /><span><span class="line">{location.metro}</span><span class="sep" aria-hidden="true"> · </span><span class="line">{location.address}</span></span></p>

        <h1>Студия нейропедагогики и&nbsp;психологии</h1>
        <p class="hero-motto">Развиваем. Поддерживаем. Готовим к&nbsp;жизни.</p>

        <!-- Первый экран отвечает на три вопроса родителя из рекламы: сколько стоит,
             можно ли сначала попробовать и можно ли доверять. -->
        <div class="hero-offer">
          <span class="offer-pill">Пробное — бесплатно</span>
          <p class="offer-meta">
            <span class="line">от {cheapest.text}&nbsp;₽ за {cheapest.lessons}&nbsp;занятия</span><span class="sep" aria-hidden="true"> · </span><a class="line" href="#reviews"><span class="offer-star" aria-hidden="true">★</span>&nbsp;{yandexRating.score} на&nbsp;Яндекс Картах · {yandexRating.ratings}</a>
          </p>
        </div>
      </div>

      <div class="hero-copy-rest">
        <p class="hero-sub">
          Развивающие занятия в&nbsp;мини-группах и&nbsp;психологическая поддержка для детей
          от&nbsp;1,5&nbsp;лет и&nbsp;подростков. Бережно, системно, с&nbsp;опорой на&nbsp;науку и&nbsp;уважение к&nbsp;ребёнку.
        </p>

        <p class="hero-approach"><strong>Педагог. Психолог. Нейропсихолог.</strong><br />Три подхода — один результат. Ведёт Татьяна Петрова, 20+&nbsp;лет опыта.</p>

        <div class="hero-ctas">
          <a href="#programs" class="btn btn-primary">Выбрать занятие</a>
          <a href="#booking" class="btn btn-secondary">Записаться на пробное</a>
        </div>

        <p class="hero-microcopy">Познакомьтесь с педагогом и форматом занятий.<br /><a href="#first-visit">Как проходит первый визит →</a></p>

        <a href="#video" class="hero-video-link">
          <span class="hero-video-link-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
          </span>
          Смотреть видео с занятий
        </a>
      </div>
    </div>

    <div class="hero-media" data-reveal>
      <div class="hero-img-wrap">
        <picture>
          <source type="image/webp" srcset={heroImage.srcset} sizes={heroImage.sizes} />
          <img src={`${import.meta.env.BASE_URL}img/hero.jpg`} width="1537" height="1023" alt="Татьяна Петрова занимается с детьми в студии «Сензитивность»" class="hero-img" fetchpriority="high" decoding="async" />
        </picture>
        {heroBadges.map((b, i) => (
          <div class:list={['floating-badge', i === 0 ? 'fb-1' : 'fb-2']}>
            <Icon name={b.icon} class="badge-icon" />
            <span>{b.text}</span>
          </div>
        ))}
      </div>
      <blockquote class="hero-review"><p>«{reviews[2].text}»</p><cite>{reviews[2].name} · <a href={yandexMapsUrl} target="_blank" rel="noopener">Яндекс Карты ↗</a></cite></blockquote>
    </div>
  </div>
</section>

<style>
  .hero-review { margin: var(--space-5) 0 0; padding: 0 var(--space-3); }
  .hero-review p { font: 400 18px/1.5 var(--font-display); color: var(--color-ink); }
  .hero-review cite { display: block; margin-top: var(--space-2); font: var(--text-meta); font-size: 12px; }
  .hero-review a, .hero-microcopy a { text-decoration: underline; text-underline-offset: 3px; }

  .hero { position: relative; overflow: hidden; padding: var(--space-6) 0 var(--space-6); }

  .hero-blob {
    position: absolute;
    top: -120px;
    right: -160px;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-lime) 55%, transparent), transparent 70%);
    animation: softpulse 6s ease-in-out infinite;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: var(--space-7);
    align-items: center;
  }

  .hero-where { display: flex; align-items: flex-start; gap: var(--space-2); margin-bottom: var(--space-5); font: var(--text-meta); font-weight: 600; color: var(--color-moss); }
  .hero-where :global(.loc-icon) { width: 15px; height: 15px; flex-shrink: 0; margin-top: .15em; }

  .hero h1 {
    font: var(--text-display);
    font-size: clamp(34px, 4.4vw, 54px);
    letter-spacing: var(--tracking-display);
  }

  .hero-sub { margin-top: var(--space-5); font: var(--text-lead); font-size: 21px; font-weight: 400; color: var(--color-ink-soft); max-width: 560px; }

  .hero h1 { text-wrap: balance; }
  .hero-motto { margin-top: var(--space-4); font: var(--text-lead); color: var(--color-moss); text-wrap: balance; }
  .hero-approach { margin-top: var(--space-4); font: var(--text-meta); line-height: 1.6; color: var(--color-ink-soft); }
  .hero-approach strong { font-weight: 600; color: var(--color-ink); }

  .hero-ctas { display: flex; gap: var(--space-4); flex-wrap: wrap; margin-top: var(--space-6); }

  /* Один акцент — бесплатное пробное; цена и рейтинг рядом обычным текстом,
     чтобы первый экран не превращался в россыпь одинаковых плашек. */
  .hero-offer { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); margin-top: var(--space-5); }
  .offer-pill { font: var(--text-meta); font-weight: 700; color: var(--color-ink); background: var(--color-lime); padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); }
  .offer-meta { font: var(--text-meta); font-weight: 600; color: var(--color-ink); }
  .offer-meta a { color: inherit; text-decoration: underline; text-decoration-color: var(--color-mist); text-underline-offset: 3px; }
  .offer-meta a:hover { text-decoration-color: currentColor; }
  .offer-star { color: var(--color-moss); }

  .hero-microcopy { margin-top: var(--space-4); font: var(--text-meta); color: var(--color-ink-soft); }

  .hero-video-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font: var(--text-meta);
    font-weight: 600;
    color: var(--color-moss);
    transition: gap .2s ease-out;
  }

  .hero-video-link-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 var(--stroke-thin) var(--color-moss);
    transition: background-color .2s ease-out, transform .2s ease-out;
  }

  .hero-video-link-icon svg { width: 11px; height: 11px; transform: translateX(1px); }

  .hero-video-link:hover { gap: var(--space-3); }
  .hero-video-link:hover .hero-video-link-icon,
  .hero-video-link:focus-visible .hero-video-link-icon { background: var(--color-moss); color: #fff; transform: scale(1.08); }
  .hero-video-link:focus-visible { outline: 2px solid var(--color-moss); outline-offset: 3px; border-radius: var(--radius-xs); }

  .hero-media { position: relative; }

  .hero-img-wrap { position: relative; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); }

  .hero-img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3.4;
    object-fit: cover;
    animation: kenburns 15s ease-in-out infinite alternate;
  }

  .floating-badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-surface);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    max-width: 152px;
    font: var(--text-meta);
    font-size: 12.5px;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .floating-badge :global(.badge-icon) { width: 17px; height: 17px; color: var(--color-moss); flex-shrink: 0; }

  .fb-1 { top: 14px; right: 14px; animation: floatY 5s ease-in-out infinite; }
  .fb-2 { bottom: 14px; left: 14px; max-width: 160px; animation: floatY2 6s ease-in-out infinite; }

  @media (max-width: 900px) {
    .hero { padding: 20px 0 32px; }
    .hero-inner { grid-template-columns: 1fr; gap: 24px; }
    .hero-copy { display: contents; }
    .hero-copy-head { grid-row: 1; }
    .hero-media { grid-row: 2; }
    .hero-copy-rest { grid-row: 3; }
    .hero-review { margin-top: var(--space-4); }
    .hero-review p { font-size: 17px; }
    .hero-where { margin-bottom: 16px; font-size: 13px; }
    /* На телефоне части строк идут отдельными строками, а не рвутся посередине фразы */
    .hero-where .line, .offer-meta .line { display: block; width: fit-content; }
    .hero-where .sep, .offer-meta .sep { display: none; }
    .hero h1 { font-size: clamp(30px, 7.8vw, 44px); line-height: 1.15; }
    .hero-sub { margin-top: 16px; font-size: 17px; line-height: 1.5; }
    .hero-motto { font-size: 18px; line-height: 1.45; }
    .hero-offer { margin-top: 14px; }
    .offer-pill { font-size: 13px; padding: 6px 12px; }
    .offer-meta { font-size: 13px; }
    .hero-ctas { margin-top: 20px; gap: 10px; }
    .hero-ctas .btn { flex: 1 1 200px; padding: 13px 18px; }
    .hero-microcopy { margin-top: 12px; font-size: 13px; }
    .hero-video-link { margin-top: 12px; }
    .hero-img { aspect-ratio: 16 / 9; height: auto; animation: none; }
    .floating-badge { display: none; }
  }
</style>
