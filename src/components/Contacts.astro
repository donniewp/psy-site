---
import { location, phone, phoneHref, yandexMapsUrl } from '../data/content';
import Icon from './Icon.astro';
---

<section class="contacts section-tight" id="contacts">
  <div class="container contacts-inner">
    <div class="map-wrap" data-reveal>
      <iframe
        src="https://yandex.ru/map-widget/v1/?ll=37.501301%2C55.817955&z=16&pt=37.501301,55.817955,pm2rdm"
        title="Карта — студия «Сензитивность» на Ленинградском шоссе"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
      <a href={yandexMapsUrl} target="_blank" rel="noopener" class="map-open-link">
        <Icon name="svc-pin" class="icon" />
        Открыть в Яндекс Картах
      </a>
    </div>

    <div class="contacts-card" data-reveal>
      <span class="eyebrow">Наши контакты</span>

      <div class="contact-line">
        <Icon name="svc-pin" class="icon" />
        <div>
          <strong>{location.address}</strong>
          <span>{location.metro}</span>
        </div>
      </div>

      <div class="contact-line">
        <Icon name="svc-clock" class="icon" />
        <span>{location.hours}</span>
      </div>

      <div class="contact-line">
        <Icon name="svc-phone" class="icon" />
        <a href={phoneHref} class="phone">{phone}</a>
      </div>

      <a href="#booking" class="btn btn-dark">Записаться на консультацию</a>
      <a href={yandexMapsUrl} target="_blank" rel="noopener" class="yandex-org-link">Страница студии на Яндекс Картах</a>
    </div>
  </div>
</section>

<style>
  .contacts-inner { display: grid; grid-template-columns: 1.1fr .9fr; gap: var(--space-6); align-items: stretch; }

  .map-wrap { position: relative; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); }
  .map-wrap iframe { width: 100%; height: 100%; min-height: 360px; border: 0; display: block; }

  /* Заметная ссылка на Я.Карты поверх виджета — у самого виджета в углу есть
     своя мелкая надпись "Открыть в Яндекс Картах", но её легко не заметить. */
  .map-open-link {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-surface);
    color: var(--color-ink);
    font: var(--text-meta);
    font-weight: 700;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-md);
    transition: background .2s ease-out, transform .2s ease-out;
  }

  .map-open-link :global(.icon) { width: 15px; height: 15px; color: var(--color-moss); flex-shrink: 0; }
  .map-open-link:hover { background: var(--color-moss); color: #fff; transform: translateY(-1px); }
  .map-open-link:hover :global(.icon) { color: #fff; }

  .contacts-card {
    background: var(--color-surface);
    box-shadow: inset 0 0 0 var(--stroke-hairline) var(--color-mist);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-line { display: flex; align-items: flex-start; gap: var(--space-3); font: var(--text-meta); color: var(--color-ink-soft); }
  .contact-line :global(.icon) { color: var(--color-moss); flex-shrink: 0; margin-top: 2px; }
  .contact-line strong { display: block; color: var(--color-ink); font-weight: 700; }
  .contact-line .phone { font: var(--text-h3); font-size: 20px; color: var(--color-ink); }

  .contacts-card .btn { margin-top: var(--space-3); align-self: flex-start; }

  .yandex-org-link {
    align-self: flex-start;
    font: var(--text-meta);
    font-weight: 600;
    color: var(--color-moss);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--color-moss) 40%, transparent);
    transition: text-decoration-color .2s ease-out;
  }

  .yandex-org-link:hover { text-decoration-color: currentColor; }

  @media (max-width: 900px) {
    .contacts-inner { grid-template-columns: 1fr; }
    .map-wrap { aspect-ratio: 16 / 10; }
  }
</style>
