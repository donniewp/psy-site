---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Problems from '../components/Problems.astro';
import Programs from '../components/Programs.astro';
import Razvivayka from '../components/Razvivayka.astro';
import Teacher from '../components/Teacher.astro';
import WhyUs from '../components/WhyUs.astro';
import Timeline from '../components/Timeline.astro';
import Prices from '../components/Prices.astro';
import Reviews from '../components/Reviews.astro';
import VideoGallery from '../components/VideoGallery.astro';
import Sunday from '../components/Sunday.astro';
import FAQ from '../components/FAQ.astro';
import Booking from '../components/Booking.astro';
import Studio from '../components/Studio.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import ChatButtons from '../components/ChatButtons.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
---

<Layout
  title="Детская студия развития, м. Войковская. Сензитивность"
  description="Занятия для детей и подростков у м. Войковская, 3 минуты пешком: подготовка к школе, нейропсихология, раннее развитие, песочная терапия. Мини-группы, педагог с опытом более 20 лет."
  localBusiness
>
  <div id="page">
    <Header />
    <main id="main-content">
      <Hero />
      <Programs />
      <Prices />
      <Problems />
      <Razvivayka />
      <Teacher />
      <WhyUs />
      <Timeline />
      <Reviews />
      <Sunday />
      <VideoGallery />
      <FAQ />
      <Studio />
      <Booking />
      <Contacts />
    </main>
    <Footer />
    <ChatButtons />
    <StickyMobileCTA />
  </div>
</Layout>
