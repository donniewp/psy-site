---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Problems from '../components/Problems.astro';
import Programs from '../components/Programs.astro';
import Razvivayka from '../components/Razvivayka.astro';
import Teacher from '../components/Teacher.astro';
import WhyUs from '../components/WhyUs.astro';
import Timeline from '../components/Timeline.astro';
import Prices from '../components/Prices.astro';
import Reviews from '../components/Reviews.astro';
import VideoGallery from '../components/VideoGallery.astro';
import FAQ from '../components/FAQ.astro';
import Booking from '../components/Booking.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import ChatButtons from '../components/ChatButtons.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
---

<Layout
  title="Сензитивность — детская студия развития Татьяны Петровой"
  description="Занятия для детей и подростков в Москве: раннее развитие, подготовка к школе, нейропсихология, песочная терапия. Мини-группы, опыт педагога более 20 лет."
>
  <div id="page">
    <AnnouncementBar />
    <Header />
    <main id="main-content">
      <Hero />
      <Problems />
      <Programs />
      <Razvivayka />
      <Teacher />
      <WhyUs />
      <Timeline />
      <Prices />
      <Reviews />
      <VideoGallery />
      <FAQ />
      <Booking />
      <Contacts />
    </main>
    <Footer />
    <ChatButtons />
    <StickyMobileCTA />
  </div>
</Layout>

<script>
  const revealTargets = document.querySelectorAll('[data-reveal]');

  // Показать всё разом — страховка на случай, когда наблюдатель недоступен.
  // Блоки в CSS стоят с opacity:0, так что без этой ветки старый браузер
  // (или упавший скрипт) оставил бы половину страницы пустой навсегда.
  const revealAll = () => revealTargets.forEach((el) => el.setAttribute('data-reveal', 'shown'));

  if (!('IntersectionObserver' in window)) {
    revealAll();
  } else {
    // threshold:0, а не доля площади. Порог считается от размера самого блока,
    // и высокий блок физически не может показать заметную свою долю: на телефоне
    // .programs-grid вырастает до ~5600px, и в окно 640px помещается максимум
    // 10% его площади — с прежним порогом 0.12 сетка программ не появлялась
    // никогда, а на экране 812px проскакивала окно всего в ~78px прокрутки и
    // терялась при быстром пролистывании. Момент появления теперь задаёт только
    // нижний rootMargin и он одинаков для блоков любой высоты.
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.setAttribute('data-reveal', 'shown');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0, rootMargin: '0px 0px -60px 0px' }
    );
    revealTargets.forEach((el) => revealObserver.observe(el));
  }

  const countTargets = document.querySelectorAll('[data-countup]');
  const countObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const target = parseInt(el.getAttribute('data-countup') || '0', 10);
        const duration = 1200;
        const start = performance.now();

        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.round(target * eased));
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
        countObserver.unobserve(el);
      });
    },
    { threshold: 0.5 }
  );
  countTargets.forEach((el) => countObserver.observe(el));
</script>
