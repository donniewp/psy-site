---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Teacher from '../components/Teacher.astro';
import Programs from '../components/Programs.astro';
import FirstVisit from '../components/FirstVisit.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import Booking from '../components/Booking.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import Problems from '../components/Problems.astro';
import Razvivayka from '../components/Razvivayka.astro';
import WhyUs from '../components/WhyUs.astro';
import Timeline from '../components/Timeline.astro';
import Sunday from '../components/Sunday.astro';
import VideoGallery from '../components/VideoGallery.astro';
import Studio from '../components/Studio.astro';
---
<Layout title="Студия нейропедагогики и психологии — Сензитивность, м. Войковская" description="Развивающие занятия и психологическая поддержка для детей и подростков 2–18 лет у м. Войковская. Бережно, системно, с опорой на науку и уважение к ребёнку." localBusiness>
  <div id="page">
    <Header />
    <main id="main-content">
      <Hero />
      <Teacher />
      <Programs />
      <FirstVisit />
      <VideoGallery />
      <Reviews />
      <WhyUs />
      <Problems />
      <Razvivayka />
      <Timeline />
      <Sunday />
      <FAQ />
      <Studio />
      <Contacts />
      <Booking />
    </main>
    <Footer />
    <StickyMobileCTA />
  </div>
</Layout>
