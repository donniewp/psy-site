---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contacts from '../components/Contacts.astro';
import Booking from '../components/Booking.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import ProgramHero from '../components/ProgramHero.astro';
import ProgramStory from '../components/ProgramStory.astro';
import ProgramBookingBar from '../components/ProgramBookingBar.astro';
import TrialNudge from '../components/TrialNudge.astro';
import { programs, programPaths } from '../data/content';
import { programPages } from '../data/programPages';
import { visitFor, individualVisitFor } from '../data/visits';
export function getStaticPaths() { return programs.map(program => ({ params: { program: programPaths[program.slug] }, props: { program } })); }
const { program: p } = Astro.props;
const page = programPages[p.slug];
const visit = visitFor(p);
const individualVisit = individualVisitFor(p);
const diagnostic = p.slug === 'diagnostics';
const consultation = p.slug === 'psychocorrection';
const cta = `?program=${encodeURIComponent(visit.value)}#booking`;
const groupAction = page.action ?? (page.paid ? visit.action : 'Записаться на бесплатное пробное');
---
<Layout title={`${p.searchName} у м. Войковская — Сензитивность`} description={`${p.ageLabel}. ${p.desc} ${p.price}. Татьяна Петрова, более 20 лет опыта. Запись в студию на Войковской.`} path={`/${programPaths[p.slug]}/`} image={p.img || '/img/hero.jpg'}>
  <Header bookingLabel={page.paid ? 'Обсудить встречу' : 'Записаться'} />
  <main id="main-content" data-booking-program={visit.value}>
    <ProgramHero program={p} page={page} cta={cta} action={groupAction} />
    <ProgramStory slug={p.slug} page={page} cta={cta} action={groupAction} />
    <Contacts />
    <Booking />
  </main>
  <Footer />
  <StickyMobileCTA diagnostic={diagnostic} consultation={consultation} mobile={false} />
  <ProgramBookingBar href={cta} action={groupAction} bar={page.bar} />
  {!page.paid && <TrialNudge mobile={false} />}
  {p.individual && <script is:inline define:vars={{ groupBooking: visit.value, individualBooking: individualVisit.value, groupAction, individualAction: individualVisit.action }}>
    (() => {
      const radios = document.querySelectorAll('input[name="lesson-format"]');
      const update = (individual, updateUrl) => {
        document.querySelectorAll('[data-group-offer]').forEach(el => { el.hidden = individual; });
        document.querySelectorAll('[data-individual-offer]').forEach(el => { el.hidden = !individual; });
        const booking = individual ? individualBooking : groupBooking;
        document.getElementById('main-content').dataset.bookingProgram = booking;
        document.querySelectorAll('[data-program-cta]').forEach(link => {
          link.href = '?program=' + encodeURIComponent(booking) + '#booking';
          link.textContent = individual ? individualAction : groupAction;
        });
        radios.forEach(radio => { radio.checked = radio.value === (individual ? 'individual' : 'group'); });
        if (updateUrl) {
          const url = new URL(location.href);
          if (individual) url.searchParams.set('format', 'individual'); else url.searchParams.delete('format');
          if (url.searchParams.has('program')) url.searchParams.set('program', booking);
          history.replaceState(null, '', url);
        }
      };
      radios.forEach(radio => radio.addEventListener('change', () => update(radio.value === 'individual', true)));
      const sync = () => {
        const params = new URLSearchParams(location.search);
        update(params.has('format') ? params.get('format') === 'individual' : params.get('program') === individualBooking, false);
      };
      sync(); window.addEventListener('popstate', sync);
    })();
  </script>}
</Layout>
