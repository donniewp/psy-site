---
import '../styles/global.css';
import { yandexMetrikaId } from '../data/content';

export interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
}

const { title, description, path = '/', image = `${import.meta.env.BASE_URL}img/hero.jpg` } = Astro.props;
const canonicalURL = new URL(path.replace(/^\//, import.meta.env.BASE_URL), Astro.site);
const ogImageURL = new URL(image.replace(/^\//, import.meta.env.BASE_URL), Astro.site);
const metrikaEnabled = yandexMetrikaId !== 'REPLACE-ME';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="ru_RU" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href={`${import.meta.env.BASE_URL}img/hero.jpg`} as="image" fetchpriority="high" />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,600&family=Golos+Text:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,600&family=Golos+Text:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </noscript>

    {metrikaEnabled && (
      <Fragment>
        <script is:inline define:vars={{ id: yandexMetrikaId }}>
          (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
          (window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

          ym(id, 'init', {
            clickmap: true,
            trackLinks: true,
            accurateTrackBounce: true,
            webvisor: true,
          });
        </script>
        <noscript>
          <div><img src={`https://mc.yandex.ru/watch/${yandexMetrikaId}`} style="position:absolute; left:-9999px;" alt="" /></div>
        </noscript>
      </Fragment>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Перейти к содержимому</a>
    <slot />

    {metrikaEnabled && (
      <script is:inline define:vars={{ id: yandexMetrikaId }}>
        // Цели: клик по кнопке/телефону/мессенджеру — по всему сайту через
        // делегирование, скролл до цен — как только секция #prices появляется
        // в зоне видимости.
        const ym = window.ym;
        if (typeof ym === 'function') {
          document.addEventListener('click', (e) => {
            const btn = e.target.closest && e.target.closest('.btn');
            if (btn) ym(id, 'reachGoal', 'button_click');

            const link = e.target.closest && e.target.closest('a[href]');
            if (!link) return;
            if (link.href.startsWith('tel:')) {
              ym(id, 'reachGoal', 'phone_click');
            } else if (link.href.includes('t.me/')) {
              ym(id, 'reachGoal', 'telegram_click');
            } else if (link.href.includes('max.ru/')) {
              ym(id, 'reachGoal', 'max_click');
            } else if (link.href.includes('wa.me/')) {
              ym(id, 'reachGoal', 'whatsapp_click');
            }
          });

          const pricesEl = document.getElementById('prices');
          if (pricesEl && 'IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries, obs) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  ym(id, 'reachGoal', 'scroll_to_prices');
                  obs.disconnect();
                }
              });
            }, { threshold: 0.3 });
            observer.observe(pricesEl);
          }
        }
      </script>
    )}
  </body>
</html>
