---
import '../styles/global.css';
import { yandexMetrikaId } from '../data/content';

export interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
}

const { title, description, path = '/', image = `${import.meta.env.BASE_URL}img/hero.jpg` } = Astro.props;
const canonicalURL = new URL(path.replace(/^\//, import.meta.env.BASE_URL), Astro.site);
const ogImageURL = new URL(image.replace(/^\//, import.meta.env.BASE_URL), Astro.site);
const metrikaEnabled = yandexMetrikaId !== 'REPLACE-ME';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Значок для выдачи: роботы Яндекса идут за /favicon.ico в корень, а Google
        игнорирует PNG со стороной мельче 48px, поэтому одного SVG не хватает.
        Файлы собирает scripts/build-favicons.mjs из public/favicon.svg. */}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${import.meta.env.BASE_URL}favicon-48x48.png`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${import.meta.env.BASE_URL}favicon-96x96.png`} />
    <link rel="icon" type="image/png" sizes="120x120" href={`${import.meta.env.BASE_URL}favicon-120x120.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${import.meta.env.BASE_URL}icon-192.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <meta name="theme-color" content="#0E6E5B" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="ru_RU" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href={`${import.meta.env.BASE_URL}img/hero.jpg`} as="image" fetchpriority="high" />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,600&family=Golos+Text:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,600&family=Golos+Text:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </noscript>

    {metrikaEnabled && (
      <Fragment>
        <script is:inline define:vars={{ id: yandexMetrikaId }}>
          (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
          (window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

          ym(id, 'init', {
            clickmap: true,
            trackLinks: true,
            accurateTrackBounce: true,
            webvisor: true,
          });
        </script>
        <noscript>
          <div><img src={`https://mc.yandex.ru/watch/${yandexMetrikaId}`} style="position:absolute; left:-9999px;" alt="" /></div>
        </noscript>
      </Fragment>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Перейти к содержимому</a>
    <slot />

    {metrikaEnabled && (
      <script is:inline define:vars={{ id: yandexMetrikaId }}>
        // Цели: клик по кнопке/телефону/мессенджеру — по всему сайту через
        // делегирование, скролл до цен — как только секция #prices появляется
        // в зоне видимости.
        const ym = window.ym;
        if (typeof ym === 'function') {
          document.addEventListener('click', (e) => {
            const btn = e.target.closest && e.target.closest('.btn');
            if (btn) ym(id, 'reachGoal', 'button_click');

            const link = e.target.closest && e.target.closest('a[href]');
            if (!link) return;
            // Явная цель на ссылке важнее домена: телеграм из формы и телеграм
            // плавающей кнопкой — разные двери, и сравнивать их надо порознь.
            if (link.dataset && link.dataset.goal) {
              ym(id, 'reachGoal', link.dataset.goal);
            } else if (link.href.startsWith('tel:')) {
              ym(id, 'reachGoal', 'phone_click');
            } else if (link.href.includes('t.me/')) {
              ym(id, 'reachGoal', 'telegram_click');
            } else if (link.href.includes('max.ru/')) {
              ym(id, 'reachGoal', 'max_click');
            } else if (link.href.includes('wa.me/')) {
              ym(id, 'reachGoal', 'whatsapp_click');
            }
          });

          const pricesEl = document.getElementById('prices');
          if (pricesEl && 'IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries, obs) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  ym(id, 'reachGoal', 'scroll_to_prices');
                  obs.disconnect();
                }
              });
            }, { threshold: 0.3 });
            observer.observe(pricesEl);
          }

          // Цели глубины прокрутки — каждый порог отправляется один раз.
          const scrollThresholds = [10, 25, 50, 75];
          const reachedScroll = new Set();
          let scrollRaf = 0;

          const checkScrollDepth = () => {
            scrollRaf = 0;
            const doc = document.documentElement;
            const scrollable = doc.scrollHeight - doc.clientHeight;
            if (scrollable <= 0) return;
            const percent = ((window.scrollY + doc.clientHeight) / doc.scrollHeight) * 100;

            scrollThresholds.forEach((threshold) => {
              if (percent >= threshold && !reachedScroll.has(threshold)) {
                reachedScroll.add(threshold);
                ym(id, 'reachGoal', `scroll_${threshold}`);
              }
            });

            if (reachedScroll.size === scrollThresholds.length) {
              window.removeEventListener('scroll', onScrollDepth);
            }
          };

          const onScrollDepth = () => {
            if (scrollRaf) return;
            scrollRaf = requestAnimationFrame(checkScrollDepth);
          };

          window.addEventListener('scroll', onScrollDepth, { passive: true });
          checkScrollDepth();

          // Цели времени на сайте — таймеры, каждый срабатывает один раз.
          [30, 60, 90, 120, 180].forEach((seconds) => {
            setTimeout(() => ym(id, 'reachGoal', `time_${seconds}`), seconds * 1000);
          });
        }
      </script>
    )}
  </body>
</html>
